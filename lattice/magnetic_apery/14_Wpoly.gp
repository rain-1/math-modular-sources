default(parisizemax,12000000000);
read("lib.gp");
print("### CM points of X_0(6) in the normalised coordinate W = 72u + 1/u = 72w");
print("(w-minpolys from 02b_cmpoly.out; W-minpoly = 72^deg * P(W/72), made primitive)");
prim(P) = my(d,g); d=1; for(j=0,poldegree(P), d=lcm(d,denominator(polcoeff(P,j)))); P=P*d; g=content(P); P/g;
CMN = ["D-8","D-12","D-15","D-20","D-23","D-24 (the two folds)","D-32","D-36","D-39","D-44","D-48","D-56","D-72","D-80","D-96","D-120","cusps 1/2,1/3"];
IMS = [0.2357,0.1443,0.3227,0.3727,0.3997,0.40825,0.2357,0.1667,0.5204,0.2764,0.2887,0.6236,0.2357,0.3727,0.40825,0.9129,-1];
{
CMP = [9*w+2, 4*w+1, 576*w^2+216*w+19, 324*w^2+72*w-1,
 139314069504*w^6+152858492928*w^5+59901825024*w^4+7704958464*w^3-953798976*w^2-347074200*w-25493369,
 18*w^2-1, 3359232*w^4+3172608*w^3+1251936*w^2+237456*w+17593, 108*w^2+72*w+11,
 36864*w^4+23040*w^3+8832*w^2+2256*w+229,
 2176782336*w^6+1330255872*w^5+374554368*w^4+186810624*w^3+80780976*w^2+15536664*w+1058849,
 96*w^2-24*w-11, 13122*w^4+17496*w^3+13041*w^2+3924*w+389, 162*w^2-144*w-43,
 11284439629824*w^8+33853318889472*w^7+60270749319168*w^6+52615247708160*w^5+25001829909504*w^4+6928322688000*w^3+1127548657152*w^2+100488665376*w+3803621569,
 41472*w^4-62208*w^3-65952*w^2-18576*w-1657, w^2-4*w-1, 72*w+17];
}
print("");
print("disc | maxIm(tau_0) | usable (< 1/sqrt6 = 0.40825)? | minimal polynomial of W");
{
for(i=1, #CMP,
  my(PW, ok);
  PW = prim(subst(CMP[i], w, W/72));
  ok = if(IMS[i]<0, "cusp", if(IMS[i] < 0.40824, "yes", "NO - above the fold"));
  print(CMN[i], " | ", IMS[i], " | ", ok, " | ", PW, "   monic? ", pollead(PW)==1);
);
}
quit;
