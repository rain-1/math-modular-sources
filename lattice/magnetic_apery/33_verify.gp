default(parisizemax,12000000000);
read("lib.gp");
default(realprecision, 60);
NQ = 405;
HH = HOSTS[3]; C=HH[2]; B=HH[3]; dv=HH[4]; rv=HH[5];
us = useries(dv,rv,NQ); Fs = Fseries(dv,rv,NQ); F2 = Fs^2;
print("### consolidated verification of the disc(-8) magnetic source on Gamma_0(6)");
NUM = -x*(72*x^2+18*x+1)*(72*x^2-1);
DEN = (72*x^2+16*x+1)^2*(72*x^2+17*x+1);
print("rho = ", NUM, "  /  ", DEN);
print("gcd(num,den) = ", gcd(NUM,DEN));
print("");
print("(1) Fricke: rho(1/(72u)) + rho(u) = ", simplify(subst(NUM,x,1/(C*x))/subst(DEN,x,1/(C*x)) + NUM/DEN), "   => Phi|_4 W_6 = -Phi");
print("(2) rho(0) = ", subst(NUM,x,0)/subst(DEN,x,0), "  (a_0(Phi) = 0 at the cusp infinity; by W_6-antiinvariance also at 0)");
print("(3) polar divisor of rho : double at the roots of 1+16u+72u^2 (disc -8 CM points,");
print("    u = ", polroots(72*x^2+16*x+1), " ), simple at the roots of 1+17u+72u^2 = (1+8u)(1+9u) (the cusps 1/2, 1/3),");
print("    and div(F^2) = 2(cusp 1/2) + 2(cusp 1/3), so Phi = F^2 rho is holomorphic on H");
print("    except for a DOUBLE POLE at the two disc(-8) CM points, and vanishes at all four cusps.");
print("(4) F is a weight-2 form on Gamma_0(6) with div(F) = (cusp 1/2) + (cusp 1/3):");
print("    F = ", Fs + O(q^9));
print("    F = 1/6 (5 E_2(tau) - 2 E_2(2tau) + 3 E_2(3tau) - 30 E_2(6tau))? check first 8 coefficients");
print("");
Phi = F2*subst(NUM,x,us)/subst(DEN,x,us);
print("(5) c(m), m=1..16 : ", vector(16,j,polcoeff(Phi,j)));
print("    integral to m=", NQ-5, "? first failure = ", intfail(Phi, NQ-5));
print("    magnetic (m|c(m))? first failure = ", magfail(Phi, NQ-5));
print("(6) growth |c(m)|^(1/m), m=200,400 : ", abs(polcoeff(Phi,200)*1.0)^(1/200), " ", abs(polcoeff(Phi,400)*1.0)^(1/400));
print("    e^(2 pi Im tau_0), Im tau_0 = sqrt2/6 : ", exp(2*Pi*sqrt(2)/6));
print("    tau_0 = -1/3 + i sqrt2/6 (form [6,4,1], disc -8); Im tau_0 = ", sqrt(2)/6, " < 1/sqrt6 = ", 1/sqrt(6));
print("(7) x(tau_0) = 1/(W_0 + 17) with W_0 = -16 : x(tau_0) = 1  (the pole sits on |x| = 1)");
print("    check numerically: u_0 = ", polroots(72*x^2+16*x+1)[1], "  x = u/(1+17u+72u^2) = ", my(u0); u0 = polroots(72*x^2+16*x+1)[1]; u0/(1+17*u0+72*u0^2));
print("(8) this Phi is MINUS the canonical source F' Dx' of the OTHER level-6 Fricke host");
print("    N=6, C=81, B=14 (u' = (eta_3 eta_6/(eta_1 eta_2))^4): compare c(1..8):");
{
my(H2, u2, F2b, P2);
H2 = HOSTS[2]; u2 = useries(H2[4],H2[5],40); F2b = Fseries(H2[4],H2[5],40)^2;
P2 = F2b*u2*(1-81*u2^2)/(1+14*u2+81*u2^2)^2;
print("    C=81 host: ", vector(8,j,polcoeff(P2,j)));
print("    our Phi  : ", vector(8,j,polcoeff(Phi,j)));
}
quit;
