default(parisizemax, 20000000000);
default(realprecision, 700);
read("build.txt");
s5=sqrt(5); ph5=(11+5*s5)/2; phm5=(5*s5-11)/2;
Lchi(s) = 5^(-s)*(zetahurwitz(s,1/5)+I*zetahurwitz(s,2/5)-I*zetahurwitz(s,3/5)-zetahurwitz(s,4/5));
LL=Lchi(2); LR=real(LL); LI=imag(LL);
xi = ph5*LI-LR; xip = -phm5*LI-LR;
Bnewp = vector(NA+1,i, B3[i]-phm5*B4[i]);
r(n) = Bnewp[n+1]/A[n+1];
d(n) = n*(r(n)-r(n-1));
default(realprecision, 60);
print("zeta(2)/5 = ", zeta(2)/5);
print("ReL(2,psi4) = ", LR);
print("ImL(2,psi4) = ", LI);
print("xi  = ", xi);
print("xi' = ", xip);
print("n*(r_n-r_{n-1}) at n = 200,150,100 : ", [d(200), d(150), d(100)]);
e2(f,n1,n2) = (n1*f(n1)-n2*f(n2))/(n1-n2);
print("Richardson (a+b/n) from (200,100): kappa = ", e2(d,200,100));
print("Richardson (a+b/n) from (200,150): kappa = ", e2(d,200,150));
print("Richardson (a+b/n) from (150,100): kappa = ", e2(d,150,100));
print("C_A = lim n*phi^-5n*A_n  (n=200,150,100): ", [200*phm5^200*A[201], 150*phm5^150*A[151], 100*phm5^100*A[101]]);
CA(n) = n*phm5^n*A[n+1];
print("Richardson C_A from (200,100): ", e2(CA,200,100), "   phi^(5/2)/(2*Pi*5^(1/4)) = ", ph5^(1/2)/(2*Pi*5^(1/4)));
print("2/(5*sqrt5) = ", 2/(5*s5));
quit;
