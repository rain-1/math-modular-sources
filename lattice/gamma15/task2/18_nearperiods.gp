/* 18_nearperiods.gp -- SAME machinery, loop around t1: must return zeta(2)/5 and xi.
   Then lindep on the far periods.                                            */
default(parisizemax, 20000000000);
default(realprecision, 200);
NC = 700; MT = 420;
s5 = sqrt(5); ph5 = (11+5*s5)/2; phm5 = (5*s5-11)/2; t1 = phm5; t2 = -ph5;
ff = vector(NC+2); ff[1]=1; ff[2]=11; for(m=2,NC, ff[m+1]=11*ff[m]+ff[m-1]);
rD = vector(NC+1, i, if(i==1, 1, 0));
r3 = vector(NC+1, i, 2*ff[i]);
r4 = vector(NC+1, i, if(i==1, 0, -2*ff[i-1]));
mk(rr) = my(b=vector(NC+1)); b[1]=0; for(n=1,NC, b[n+1] = ((11*n^2-11*n+3)*b[n] + if(n>=2,(n-1)^2*b[n-1],0) + rr[n])/n^2); b;
Av = vector(NC+1); Av[1]=1; for(n=1,NC, Av[n+1] = ((11*n^2-11*n+3)*Av[n] + if(n>=2,(n-1)^2*Av[n-1],0))/n^2);
BDv = mk(rD); B3v = mk(r3); B4v = mk(r4);
Bnw  = vector(NC+1, i, B3v[i] + ph5*B4v[i]);
Bnwp = vector(NC+1, i, B3v[i] - phm5*B4v[i]);
ev(cf, x)  = my(s=0); forstep(k=NC, 0, -1, s = s*x + cf[k+1]); s;
evd(cf, x) = my(s=0); forstep(k=NC, 1, -1, s = s*x + k*cf[k+1]); s;
rser0(x0, M) = vector(M+1, i, 0);
rserC(x0, M, c) = vector(M+1, i, if(i==1, c, 0));
rserP(x0, M, c, a) = my(e0 = 1-a*x0); my(v=vector(M+1)); my(t=c/e0); for(i=0,M, v[i+1]=t; t = t*a/e0); v;
stp(y0, y1, x0, h, Rv) = my(p0=x0-11*x0^2-x0^3, p1=1-22*x0-3*x0^2, p2=-11-3*x0, p3=-1); my(q0=1-22*x0-3*x0^2, q1=-22-6*x0, q2=-3); my(r0=-(3+x0), r1=-1); my(c=vector(MT+3)); c[1]=y0; c[2]=y1; for(n=0, MT, my(cn1=c[n+2], cn=c[n+1], cm1=if(n>=1, c[n], 0)); my(rhs = Rv[n+1] - (p1*(n+1)*n*cn1 + p2*n*(n-1)*cn + p3*(n-1)*(n-2)*cm1 + q0*(n+1)*cn1 + q1*n*cn + q2*(n-1)*cm1 + r0*cn + r1*cm1)); c[n+3] = rhs/(p0*(n+2)*(n+1))); my(s=0, sd=0); forstep(k=MT+2, 0, -1, s = s*h + c[k+1]); forstep(k=MT+2, 1, -1, sd = sd*h + k*c[k+1]); [s, sd];
rad(x) = vecmin([abs(x), abs(x-t1), abs(x-t2)]);
walk(st, x0, x1, kind, par) = my(y=st[1], yp=st[2], cur=x0); while(abs(x1-cur) > 1e-80, my(rr=rad(cur)); my(rem=abs(x1-cur)); my(h=min(rem, 0.35*rr)); my(dir=(x1-cur)/rem); my(Rv = if(kind==0, rser0(cur,MT), if(kind==1, rserC(cur,MT,1), rserP(cur, MT, par[1], par[2])))); my(z=stp(y, yp, cur, h*dir, Rv)); y=z[1]; yp=z[2]; cur = cur + h*dir); [y, yp];
run(cf, kind, par, verts) = my(x0=verts[1]); my(st=[ev(cf,x0), evd(cf,x0)]); for(j=2, #verts, st = walk(st, verts[j-1], verts[j], kind, par)); st;
/* ---- loop around t1: base point t1+0.05, small circle radius 0.05 ---- */
rho1 = 0.05; xb1 = t1 + rho1;
appr1 = [0.05*I, 0.10+0.05*I, xb1];
Nc = 64; circ1 = vector(Nc+1, i, t1 + rho1*exp(2*Pi*I*(i-1)/Nc));
path1 = concat(appr1, circ1[2..Nc+1]);
gA = run(Av, 0, 0, path1); sA = run(Av, 0, 0, appr1);
gD = run(BDv, 1, 0, path1); sD = run(BDv, 1, 0, appr1);
gN = run(Bnw, 2, [2, -phm5], path1); sN = run(Bnw, 2, [2, -phm5], appr1);
gP = run(Bnwp, 2, [2, ph5], path1); sP = run(Bnwp, 2, [2, ph5], appr1);
dA=gA[1]-sA[1]; dD=gD[1]-sD[1]; dN=gN[1]-sN[1]; dP=gP[1]-sP[1];
z2=zeta(2);
Lch(s) = 5^(-s)*(zetahurwitz(s,1/5)+I*zetahurwitz(s,2/5)-I*zetahurwitz(s,3/5)-zetahurwitz(s,4/5));
LL=Lch(2); LR=real(LL); LI=imag(LL); xi = ph5*LI-LR; xip = -phm5*LI-LR;
print("=== VALIDATION: monodromy around t1 ===");
print("  Delta A      = ", dA);
print("  pi^{t1}(B_D)   = ", dD/dA);
print("     zeta(2)/5   = ", z2/5);
print("     difference  = ", dD/dA - z2/5);
print("  pi^{t1}(B_new) = ", dN/dA);
print("     xi          = ", xi);
print("     difference  = ", dN/dA - xi);
print("  Delta B'_new (should NOT be a multiple of u: log^2 at t1) = ", dP);
print("");
read("far.txt");
print("=== FAR periods at t2 (from 17_farperiods.gp) ===");
print("  pi_D = ", piD);
print("  pi'  = ", pip);
print("  pi_D + 11*zeta(2)/5 = ", piD + 11*z2/5);
print("  pi'  - xi'          = ", pip - xip);
print("  lindep [pi_D, 1, zeta(2), ReL, ImL, sqrt5, sqrt5 ReL, sqrt5 ImL] = ", lindep([real(piD), 1, z2, LR, LI, s5, s5*LR, s5*LI], 60));
print("  lindep [pi' , 1, zeta(2), ReL, ImL, sqrt5, sqrt5 ReL, sqrt5 ImL] = ", lindep([real(pip), 1, z2, LR, LI, s5, s5*LR, s5*LI], 60));
quit;
