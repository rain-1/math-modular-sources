default(parisizemax, 10G);
default(realprecision, 300);
read("/home/ubuntu/code/math-modular-sources/lattice/multislope/sc_rows.gp");
Xcf = ['n^3, -22*'n^3+33*'n^2-23*'n+6, 119*'n^3-357*'n^2+366*'n-128, 22*'n^3-99*'n^2+155*'n-84, ('n-2)^3];
NN = 700;
AA = genseq(Xcf, 4, [1,6,47,408], NN);
print("A_n check: ", vector(9,i,AA[i]));
print("A_n nonintegral count: ", sum(i=1,#AA, if(denominator(AA[i])==1,0,1)));
lc = vector(5,i,polcoeff(Xcf[i],3,'n'));
chp = sum(i=0,4, lc[i+1]*'x^(4-i));
print("char poly ", chp, "  factor ", factor(chp), "  roots ", polroots(chp));
XX = vector(3, j, compan(Xcf, 4, j, NN));
for(j=1,3, print("X^(",j,") first: ", vector(7,i,XX[j][i])));
for(j=1,3, print("k sharp for X^(",j,"): ", denexp(XX[j], 300)));
xi = vector(3, j, XX[j][NN+1]*1./AA[NN+1]);
for(j=1,3, print("xi_",j," = ", xi[j]));
for(j=1,3, print("  Cauchy |r_N - r_{N-50}| = ", abs(xi[j] - XX[j][NN-49]*1./AA[NN-49])));
print();
print("|X^(j)_n - xi_j A_n|^(1/n)  vs lambda_1=11.0902, lambda_2=0.0901699");
for(j=1,3, print("  j=",j,": ", vector(6, i, abs(XX[j][100*i+1]-xi[j]*AA[100*i+1])^(1./(100*i)))));
print("  |A_n|^(1/n): ", vector(6, i, abs(AA[100*i+1]*1.)^(1./(100*i))));
print("  |X^1_n/A_n - xi_1| at n=100..600: ", vector(6, i, abs(XX[1][100*i+1]/AA[100*i+1]-xi[1])));
