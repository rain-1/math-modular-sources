default(realprecision, 150);
Lval(D, s) = my(f=abs(D)); sumpos(n=1, kronecker(D,n)/n^s);
z2 = zeta(2); z3 = zeta(3);
G  = Lval(-4,2); Lm3 = Lval(-3,2); Lm7 = Lval(-7,2); Lm8 = Lval(-8,2); Lm11 = Lval(-11,2);
L3m3 = Lval(-3,3); L3c5 = Lval(5,3); L3c8 = Lval(8,3); L3c12 = Lval(12,3);
print("zeta(2)=",z2); print("G=",G); print("L(2,chi_-3)=",Lm3);
chk(xi, nm) = print(nm,":  xi=",xi); print("   /z2=",xi/z2, "  /z3=",xi/z3, "  /G=",xi/G, "  /L(2,chi-3)=",xi/Lm3, "  /L(3,chi-3)=",xi/L3m3, "  /L(3,chi5)=",xi/L3c5);
chk(0.16449340668482264364724151666460251892189499012067984377355582293700074704032008738336289006197587, "N=5 C=125 B=22");
chk(0.20561675835602830455905189583075314865236873765084980471694477867125093380040010922920361257746983, "N=6 C=81 B=14");
chk(0.19532560322412157421679685740602308909128358413632135505552501574172174616290455452321739270805246, "N=6 C=64 B=20");
chk(0.22899139854430475376365087873309602769353734357041803356662452990544075494406369236983912823152877, "N=8 C=16 B=24");
chk(0.24415700403015196510335953974140189983043255868732861136805547535870168823086366735856542667918045, "N=12 C=1 B=34");
chk(0.39065120644824314843359371481204617818256414401196120700903124381282727718873737768692549881779847, "N=18 C=1 B=14");
print();
x1 = 0.00060230600388001853945247510920578188199907590611850215023982557189487066462708435649288004243916;
x2 = 0.00060392152391405619529642833374638569165693876304970422408672554741294568265260633585267226197871;
x3 = 0.000021565182982732333022077156243775659351805111730865335121202103329282056457155356497492720986516;
print("5-point N=10: lindep[1,xi,z2,z3,Lm3,G] = ", lindep([1,x1,z2,z3,Lm3,G], 30));
