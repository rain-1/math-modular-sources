default(realprecision,60);
G5=znstar(5,1);
ch=lfuncreate([G5,4]);
Lc(s)=lfun(ch,s);
Z(s)=lfun(1,s);
S(s)=10*(1-5^(2-s))*Z(s)*Z(s-3) + Z(s)*Lc(s-3) - 5*sqrt(5)*Z(s-3)*Lc(s);
print("zeta(0)=",Z(0));
print("L(0,chi5)=",Lc(0));
print("L(3,chi5)=",Lc(3));
print("zeta(3)=",Z(3));
print("S(3)=",S(3));
print("pred = -(1/2)(8z3-5sqrt5 L3) = ", -(1/2)*(8*Z(3)-5*sqrt(5)*Lc(3)));
print("diff=",S(3)+(1/2)*(8*Z(3)-5*sqrt(5)*Lc(3)));
print("term1=",10*(1-5^(2-3))*Z(3)*Z(0), "  -4z3=",-4*Z(3));
print("term2=",Z(3)*Lc(0));
print("term3=",-5*sqrt(5)*Z(0)*Lc(3), "  (5sqrt5/2)L3=",5*sqrt(5)/2*Lc(3));
E11=mfeisenstein(4,1,1);
Echi1=mfeisenstein(4,1,Mod(4,5));
E1chi=mfeisenstein(4,Mod(4,5),1);
print("E^{1,1} a=",mfcoefs(E11,6));
print("E^{chi,1} a=",mfcoefs(Echi1,6));
print("E^{1,chi} a=",mfcoefs(E1chi,6));
mf=mfinit([5,4,0],3);
print("type mfinit[5,4,0] = ",type(mf));
F=mflinear([E11,mfbd(E11,5),E1chi,Echi1],[10,-250,1,-5*sqrt(5)]);
print("F coefs=",mfcoefs(F,8));
print("F level/char=",mfparams(F));
quit;
