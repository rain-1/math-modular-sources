default(parisizemax, 4000000000);
default(realprecision, 170);
c16 = -0.3675525969478613663408843322086462942649243202444271018662440135273535356461798632269200192154472594717987128837323873622733949551324062311018114788666613466551650475892467;
cR  = -0.6432170446587573910965475813651310149636175604277474282659270236728686873808147606471100336270327040756477475465316778839784411714817109044281700880166573566465388332811818;
cI  =  0.51979786748911740527057870018217117396231131102212881807265660110480849212760755355479894562959568725877112112167171421718085515504830842661555427706041928229984204482479044;
print("c1_I6 * Pi*sqrt(3)/2 = ", c16*Pi*sqrt(3)/2);
print("c1_I6 + 2/(Pi*sqrt(3)) = ", c16 + 2/(Pi*sqrt(3)));
print();
print("cI * Pi*sqrt(6)/4 = ", cI*Pi*sqrt(6)/4);
print("cI - 4/(Pi*sqrt(6)) = ", cI - 4/(Pi*sqrt(6)));
print();
print("cR*Pi = ", cR*Pi);
print("cR*Pi*sqrt(2) = ", cR*Pi*sqrt(2));
print("cR/cI = ", cR/cI);
print("lindep([cR, cI, cI*log(2), cI*log(3), cI*log(27)]) = ", lindep([cR, cI, cI*log(2), cI*log(3)]));
print("cR/cI + log(27)/(2*Pi)*0 = ");
print("  (cR/cI) = ", cR/cI);
c = cR + I*cI;
print("arg(c1_I3)/Pi = ", arg(c)/Pi);
print("|c1_I3| = ", abs(c), "   |c1_I3|*Pi*sqrt(3)/2 = ", abs(c)*Pi*sqrt(3)/2);
print("|c1_I3|*Pi = ", abs(c)*Pi);
print("lindep([abs(c)*Pi, 1, sqrt(2), sqrt(3), sqrt(6)]) = ", lindep([abs(c)*Pi, 1, sqrt(2), sqrt(3), sqrt(6)]));
quit;
