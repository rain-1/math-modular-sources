default(parisizemax, 6000000000);
ap = [[5,0],[7,0],[11,-14],[13,0],[17,2],[19,34],[23,0],[29,0],[31,0],[37,0],[41,-46],[43,-14],[47,0],[53,0],[59,82],[61,0],[67,-62],[71,0],[73,-142],[79,0],[83,-158],[89,146],[97,-94],[101,0],[103,0],[107,178],[109,0],[113,98],[127,0],[131,-62],[137,-238],[139,-206],[149,0],[151,0],[157,0],[163,322],[167,0],[173,0],[179,34],[181,0],[191,0],[193,98],[197,0],[199,0]];
{
foreach([8,16,24,32,40,48,56,64,72,96,128,144,192,200,256,288,384,576], nn,
  my(mfx, ebx);
  mfx = mfinit([nn,3,-8],0);
  ebx = mfeigenbasis(mfx);
  for(i=1,#ebx,
    my(cf, ok);
    if(poldegree(mfparams(ebx[i])[4])>1 && type(mfcoefs(ebx[i],5))!="t_VEC", next);
    cf = mfcoefs(ebx[i], 210);
    ok = 1;
    for(j=1,#ap, my(p=ap[j][1]); if(nn%p==0, next); if(cf[p+1] != ap[j][2], ok=0; break));
    if(ok, print("MATCH  level ", nn, " form #", i, "  a_n= ", vector(24,k,cf[k+1])))));
}
print("done");
quit;
