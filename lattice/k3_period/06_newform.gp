default(parisizemax, 6000000000);
ap = [[5,0],[7,0],[11,-14],[13,0],[17,2],[19,34],[23,0],[29,0],[31,0],[37,0],[41,-46],[43,-14],[47,0],[53,0],[59,82],[61,0],[67,-62],[71,0],[73,-142],[79,0],[83,-158],[89,146],[97,-94],[101,0],[103,0],[107,178],[109,0],[113,98],[127,0],[131,-62],[137,-238],[139,-206],[149,0],[151,0],[157,0],[163,322],[167,0],[173,0],[179,34],[181,0],[191,0],[193,98],[197,0],[199,0]];
mf8 = mfinit([8,3,-8], 0);
eb = mfeigenbasis(mf8);
print("#newforms S_3^new(8,chi_-8) = ", #eb);
cf = mfcoefs(eb[1], 210);
print("8.3.d.a  a_n (n<=20) = ", vector(20, k, cf[k+1]));
{
for(j=1,#ap,
  my(p=ap[j][1], a=ap[j][2], b=cf[p+1], r);
  r = if(b==0, "-", a/b);
  print("  p=", p, "  p%24=", p%24, "  ours=", a, "  8.3.d.a=", b, "  ratio=", r));
}
quit;
