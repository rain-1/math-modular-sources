default(parisizemax, 8000000000);
default(realprecision, 220);
mf32 = mfinit([32,3,-8],0); gg = mfeigenbasis(mf32)[1];
LL = lfunmf(mf32, gg);
L2 = lfun(LL,2);
om2 = gamma(1/8)*gamma(3/8)/(gamma(5/8)*gamma(7/8));
print("Gamma-quotient  w2 = G(1/8)G(3/8)/(G(5/8)G(7/8)) = ");
print(om2);
print();
print("L(g,2) = "); print(L2);
print("L(g,2) - Pi*w2/32 = ", L2 - Pi*om2/32);
print();
xr = sqrt(2)*L2/3; xi = L2/3;
print("Re xi = sqrt2 L(g,2)/3 = "); print(xr);
print("Im xi = L(g,2)/3 = ");     print(xi);
print("xi_I6 = 2 sqrt2 L(g,2)/3 = "); print(2*xr);
print();
print("Pi*w2*sqrt2/96 = ", Pi*om2*sqrt(2)/96);
print("|xi| = L(g,2)/sqrt3 = ", L2/sqrt(3));
quit;
