default(parisizemax,6000000000); default(realprecision,300);
xi=0.;
{CS(D)=my(h=qfbclassno(D), w=if(D==-3,6,if(D==-4,4,2)), P=1.0);
 for(j=1,abs(D)-1, if(gcd(j,abs(D))==1, P=P*gamma(j/abs(D))^kronecker(D,j)));
 P^(w/(4*h))/sqrt(2*Pi*abs(D));}
Om=[CS(-3),CS(-4),CS(-8),CS(-24)];
print("Omega(-3,-4,-8,-24) = ",Om);
L(D,s)=lfun(lfuncreate(D),s);
G=L(-4,2);
b1=[xi,1,zeta(3),Pi^2,Pi^3,G,L(-3,2),L(-8,2),L(-24,2),L(8,2),L(12,2),L(24,2),Pi*log(2),Pi*log(1+sqrt(2))];
print("basis1: ",lindep(b1,140)~);
{for(k=1,4, for(j=-2,3,
  my(v=lindep([xi, Pi^j*Om[k]^4],110));
  if(vecmax(abs(v))<10^12, print("  HIT disc idx ",k," j=",j," ",v~))));}
{for(k=1,4, for(j=-2,3,
  my(v=lindep([xi, Pi^j*Om[k]^2],110));
  if(vecmax(abs(v))<10^12, print("  HIT^2 disc idx ",k," j=",j," ",v~))));}
print("2-term scan done");
b3=[xi,Om[4]^4,Pi*Om[4]^4,Om[4]^4/Pi,1];
print("basis3: ",lindep(b3,110)~);
b4=[xi,Om[3]^4,Pi*Om[3]^4,Om[3]^4/Pi,1];
print("basis4: ",lindep(b4,110)~);
\\ period-polynomial ratios
LP1=0.072345492856750402624777808954187228373748121247246258973596731973082869073617782;
LP3=0.15603784917679414196922248595482157423020859735459704640330761127695125523991604;
print("L1/L2 = ",LP1/xi, "   L3/L2 = ",LP3/xi);
print("lindep[L1/L2, 1, Pi, 1/Pi, sqrt(6), sqrt(6)/Pi, Pi/sqrt6]: ",lindep([LP1/xi,1,Pi,1/Pi,sqrt(6),sqrt(6)/Pi,Pi/sqrt(6)],60)~);
\q
