read("/home/ubuntu/code/math-modular-sources/lattice/sources_s18_zud/s18_setup.gp");
print("t_18 = ", T18+O(x^12));
print("F_18 = ", F18+O(x^12));
print("Phi  = F*Dt = ", PHI18+O(x^14));
print("--- c(m)/m integral? ---");
print(vector(M,m, polcoeff(PHI18,m)/m));
print("--- Z := D log x_18 ; test Z = -F*sqrt(1-16t) ---");
Z = x*deriv(U18/x)/(U18/x);
print("Z = ", Z+O(x^10));
print("Z + F*sqrt(1-16t) = ", (Z + F18*sqrt(1-16*T18))+O(x^30));
print("--- test (3-x)/(3+x) = -sqrt(1-12t) ---");
X18 = U18/x;
print("(3-X)/(3+X) + sqrt(1-12t) = ", ((3-X18)/(3+X18) + sqrt(1-12*T18))+O(x^30));
print("--- FZ = -F^2 sqrt(1-16t) in M_4(Gamma_0(18)) ---");
FZ = F18*Z;
print("FZ = ", FZ + O(x^16));
print("--- u0 = sqrt(F18), and Phi' = u0*Dt (weight 3) ---");
u0 = sqrt(F18);
print("u0 = ", u0+O(x^16));
PHIp = u0*x*deriv(T18);
print("Phi' = ", PHIp+O(x^20));
print("Phi' coeffs: ", vector(M,m,polcoeff(PHIp,m)));
quit;
