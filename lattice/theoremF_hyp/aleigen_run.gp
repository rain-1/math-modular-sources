read("lattice/theoremF_hyp/aleigen.gp");
triv(m) = 1;
chim3(m) = kronecker(-3,m);
chim4(m) = kronecker(-4,m);
chi5(m)  = kronecker(5,m);
print("=== Atkin-Lehner eigenvalues, oldform basis (lambda normalised to 1)");
print("F  (w=1, E level 3, chi=chi_-3),  P = 1 - 7 V2 - 8 V4");
alrow("F", 1, [1,2,4], [1,-7,-8], 4, chim3);
print("alpha Domb (w=2, E level 1, chi=1), P = 1-17V2-9V3+16V4+153V6-144V12");
alrow("alpha", 2, [1,2,3,4,6,12], [1,-17,-9,16,153,-144], 3, triv);
alrow("alpha", 2, [1,2,3,4,6,12], [1,-17,-9,16,153,-144], 4, triv);
print("epsilon (w=2, E level 1, chi=1), P = 1-21V2+84V4-64V8");
alrow("epsilon", 2, [1,2,4,8], [1,-21,84,-64], 8, triv);
print("gamma Apery (w=2, E level 1, chi=1), P = 1-28V2+63V3-36V6");
alrow("gamma", 2, [1,2,3,6], [1,-28,63,-36], 6, triv);
print("delta twin level 6 (w=2, E level 1, chi=1), P' = 1-4V2-V3+4V6");
alrow("delta'", 2, [1,2,3,6], [1,-4,-1,4], 2, triv);
alrow("delta'", 2, [1,2,3,6], [1,-4,-1,4], 3, triv);
alrow("delta'", 2, [1,2,3,6], [1,-4,-1,4], 6, triv);
print("delta canonical level 12, P = 1-14V2-V3+16V4+14V6-16V12");
alrow("delta", 2, [1,2,3,4,6,12], [1,-14,-1,16,14,-16], 4, triv);
print("C (w=1, E level 3, chi=chi_-3), P = 1-8V2");
alrow("C", 1, [1,2], [1,-8], 2, chim3);
print("E (w=1, E level 4, chi=chi_-4), P = 1-8V2");
alrow("E", 1, [1,2], [1,-8], 2, chim4);
print("A (w=1, E level 3, chi=chi_-3 as phi), P = 1-V2");
alrow("A", 1, [1,2], [1,-1], 2, chim3);
print("eta canonical level 20 (w=2, E level 5, chi=chi5), P = 1-14V2-16V4");
alrow("eta", 2, [1,2,4], [1,-14,-16], 4, chi5);
print("B canonical level 36 (w=1, E level 3, chi=chi_-3), P = 1-6V2-8V4");
alrow("B", 1, [1,2,4], [1,-6,-8], 4, chim3);
quit;
