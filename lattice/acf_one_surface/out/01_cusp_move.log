=== A. rows (first terms) ===
A  : [1, 2, 10, 56, 346, 2252, 15184, 104960]
C  : [1, 3, 15, 93, 639, 4653, 35169, 272835]
F  : [1, 6, 42, 312, 2394, 18756, 149136, 1199232]
F' : [1, -6, 42, -312, 2394, -18756, 149136, -1199232]

=== B. Hauptmodul identities on X_0(6) ===
t_C  = q - 4*q^2 + 10*q^3 - 20*q^4 + 39*q^5 - 76*q^6 + 140*q^7 - 244*q^8 + O(q^9)
t_A  = t_C/(1-t_C)  = q - 3*q^2 + 3*q^3 + 5*q^4 - 18*q^5 + 15*q^6 + 24*q^7 - 75*q^8 + O(q^9)
t_F' = t_C/(1-9t_C) = q + 5*q^2 + 19*q^3 + 61*q^4 + 174*q^5 + 455*q^6 + 1112*q^7 + 2573*q^8 + O(q^9)
t_F  = q - 5*q^2 + 19*q^3 - 61*q^4 + 174*q^5 - 455*q^6 + 1112*q^7 - 2573*q^8 + O(q^9)
check  t_F(tau)  = -t_F'(tau+1/2) :  O(q^261)
check  t_F'      = -t_F(tau+1/2)  :  O(q^261)

=== C. the weight-one forms ===
F_C  from row  vs eta quotient : vanishes to order 241   (row truncation NR=240)
F_F  from row  vs eta quotient : vanishes to order 241   (row truncation NR=240)
F_A  = 1 + 2*q + 4*q^2 + 2*q^3 + 2*q^4 + 4*q^6 + 4*q^7 + 4*q^8 + O(q^9)
F_F' = 1 - 6*q + 12*q^2 - 6*q^3 - 6*q^4 + 12*q^6 - 12*q^7 + 12*q^8 + O(q^9)
check F_F'(tau) = F_F(tau+1/2) : vanishes to order 241   (row truncation NR=240)

=== D. gauge factors g = F_X / F_C as rational functions of t_C ===
g_A  = F_A /F_C = 1 - q + 4*q^2 - 10*q^3 + 20*q^4 - 39*q^5 + 76*q^6 - 140*q^7 + 244*q^8 + O(q^9)
g_F' = F_F'/F_C = 1 - 9*q + 36*q^2 - 90*q^3 + 180*q^4 - 351*q^5 + 684*q^6 - 1260*q^7 + 2196*q^8 + O(q^9)
g_A  as a series in t_C   : 1 - q + O(q^6)
g_F' as a series in t_C   : 1 - 9*q + O(q^6)
g_A  - (1 - t_C)          : vanishes to order 241   (row truncation NR=240)
g_F' - (1 - 9 t_C)        : vanishes to order 241   (row truncation NR=240)

=== E. so:  F_A = (1-t_C) F_C ,  F_F' = (1-9t_C) F_C   [EXACT] ===
