t_A = x - 3*x^2 + 3*x^3 + 5*x^4 - 18*x^5 + 15*x^6 + 24*x^7 - 75*x^8 + O(x^9)
t_C = x - 4*x^2 + 10*x^3 - 20*x^4 + 39*x^5 - 76*x^6 + 140*x^7 - 244*x^8 + O(x^9)
t_F = x - 5*x^2 + 19*x^3 - 61*x^4 + 174*x^5 - 455*x^6 + 1112*x^7 - 2573*x^8 + O(x^9)

A - C/(1-C)      : O(x^32)
F + C/(1-9C)     : 2*x + 38*x^3 + 348*x^5 + 2224*x^7 + 11378*x^9 + 49800*x^11 + 193804*x^13 + 687444*x^15 + 2260836*x^17 + 6979576*x^19 + 20415376*x^21 + 56988240*x^23 + 152685806*x^25 + 394467446*x^27 + 986463660*x^29 + 2395487104*x^31 + O(x^32)
F - C/(1-9C)     : -10*x^2 - 122*x^4 - 910*x^6 - 5146*x^8 + O(x^10)
F - A/(1+8A)     : 6*x^2 - 96*x^3 + 1142*x^4 - 12416*x^5 + 131298*x^6 - 1377664*x^7 + 14426134*x^8 - 150988800*x^9 + O(x^10)
F + A/(1-8A)     : 2*x + 38*x^3 + 348*x^5 + 2224*x^7 + 11378*x^9 + O(x^10)

/* F - w is even and F + w is odd, w := t_C/(1-9 t_C): hence w(-x) = -t_F(x). */
t_F(x) + w(-x)   : O(x^32)
  ==> the F-row is the (-1)^n twist of the third X_0(6) coordinate w.
