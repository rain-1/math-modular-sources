default(parisize,"20G");
default(realprecision,240);
M=500;
et(k)=prod(m=1,M\k+1,1-'q^(k*m)+O('q^(M+2)));
h=et(1)^3*et(4)*et(6)^2/(et(2)^2*et(3)*et(12)^3)/'q;
x=h/((h+3)*(h+4));
E8(k)=1+480*sum(m=1,M\k+1,sigma(m,7)*'q^(k*m))+O('q^(M+2));
Phi=(E8(1)-572*E8(2)+11583*E8(3)-36608*E8(4)+46332*E8(6)-20736*E8(12))/480;
U=Phi/('q*deriv(x,'q));
print("Phi = ",Phi+O('q^9));
print("U(q) = ",U+O('q^9));
Ps=truncate(Phi); Us=truncate(U); xs=truncate(x);
ev(s,z)=subst(s,'q,z);
th=1.9; N=12; tau=(cos(th)+I*sin(th))/sqrt(N); taup=-1/(N*tau);
q1=exp(2*Pi*I*tau); q2=exp(2*Pi*I*taup);
print("test point |q1|=",precision(abs(q1),8),"  |q2|=",precision(abs(q2),8));
print("Phi|_8 W_12 / Phi = ",precision(ev(Ps,q2)/((sqrt(N)*tau)^8*ev(Ps,q1)),40));
print("U|_6 W_12 / U     = ",precision(ev(Us,q2)/((sqrt(N)*tau)^6*ev(Us,q1)),40));
print("x(W tau) - x(tau) = ",precision(ev(xs,q2)-ev(xs,q1),20));
qc=exp(-Pi/sqrt(3));
print("Phi(tau_c) = ",precision(ev(Ps,qc),20));
print("U(tau_c)   = ",precision(ev(Us,qc),40));
print();
print("=== old coordinate (repository level12_parent):  x'=eta4^2 eta12^2/(eta1^2 eta3^2), t=x'/(16x'^2+2x'+1)");
NQ=260; NC=230;
et2(k)=prod(m=1,NQ\k+1,1-'q^(k*m)+O('q^(NQ+2)));
xo='q*et2(4)^2*et2(12)^2/(et2(1)^2*et2(3)^2);
t=xo/(16*xo^2+2*xo+1);
g=vector(NQ,m,sum(i=1,6,my(d0=[1,2,3,4,6,12][i],c0=[1,-572,11583,-36608,46332,-20736][i]);if(m%d0==0,c0*sigma(m\d0,7),0)));
Ph2=sum(m=1,NQ,g[m]*'q^m)+O('q^(NQ+1));
Ps2=sum(m=1,NQ,(g[m]/m^7)*'q^m)+O('q^(NQ+1));
F=Ph2/('q*deriv(t,'q));
Qt=serreverse(t+O('q^(NC+2)));
AA=subst(F+O('q^(NC+2)),'q,Qt);
BB=AA*subst(Ps2+O('q^(NC+2)),'q,Qt);
An=vector(NC+1,i,polcoeff(AA,i-1)); Bn=vector(NC+1,i,polcoeff(BB,i-1));
print("A_0..A_5 = ",vector(6,i,An[i]));
xi=(209/1728)*zeta(7);
{foreach([50,100,150,200,230],n, print("  n=",n,"  |B_n/A_n - xi|^(1/n) = ",precision(abs(1.0*Bn[n+1]/An[n+1]-xi)^(1/n),12),"   digits=",precision(-log(abs(1.0*Bn[n+1]/An[n+1]-xi))/log(10),8)));}
print("  (new host rate 7-4sqrt3 = ",precision(7-4*sqrt(3),12),")");
quit;
