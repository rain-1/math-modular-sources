default(parisize,"12G");
default(linewrap,0);
BASE="/tmp/claude-1000/-home-ubuntu-code-math-modular-sources/9a849c0a-95f8-4d19-b342-98033d0d9c03/scratchpad/zeta7/";
TP=(L+1)^7*(L^2-14*L+1)^6;
tv=vector(20,i,polcoeff(TP,20-i));
read(concat(BASE,"rec_19_13.gp"));
pj=vector(20,i,polcoeff(PV[i],13,n));
c0=pj[1];
print("(19,13) canonical: p_j = c0*t_j exactly? ",vector(20,i,pj[i]==c0*tv[i])==vector(20,i,1));
print("  c0 digits ",#Str(abs(c0))," sign ",sign(c0));
sm(x)=my(s=1,y=abs(x),e);forprime(q=2,100000,e=0;while(y%q==0,y=y/q;e=e+1);if(e>0,s=s*q^e));[factor(s),#Str(y)];
print("  c0 smooth part <1e5 : ",sm(c0));
hd(x,k)=concat(concat(Str(sign(x)<0),substr(Str(abs(x)),1,k)),concat("...",substr(Str(abs(x)),#Str(abs(x))-k+1,k)));
print("  P_0 = n^7*(a6 n^6+...+a0), a6 = ",hd(polcoeff(PV[1],13,n),25));
print("  P_1 leading coeff (n^13) = ",hd(polcoeff(PV[2],13,n),25)," ; P_1 constant term = ",hd(polcoeff(PV[2],0,n),25));
print("  ratio P_1lead/P_0lead = ",polcoeff(PV[2],13,n)/polcoeff(PV[1],13,n));
read(concat(BASE,"rec_23_10.gp"));
print("(23,10): p_0 = ",hd(polcoeff(PV[1],10,n),25),"  chi content ",content(sum(jj=0,23,polcoeff(PV[jj+1],10,n)*L^(23-jj))));
read(concat(BASE,"rec_17_15.gp"));
print("(17,15): p_0 = ",hd(polcoeff(PV[1],15,n),25),"  chi content ",content(sum(jj=0,17,polcoeff(PV[jj+1],15,n)*L^(17-jj))));
read(concat(BASE,"rec_19_13_constres.gp"));
print("(19,13) constres: chi content ",content(sum(jj=0,19,polcoeff(PV[jj+1],13,n)*L^(19-jj))));
CC=read(concat(BASE,"constres_C.txt"));
print("C smooth part: ",sm(C));
quit;
