default(realprecision,400);
s3=sqrt(3);
P5abs=159446553408*s3-276169531104;
print("P5 = 276169531104 - 159446553408*sqrt3 = ",precision(-P5abs,30));
print("content gcd = ",gcd(159446553408,276169531104));
print("  159446553408 = ",factor(159446553408));
print("  276169531104 = ",factor(276169531104));
g=gcd(159446553408,276169531104);
print("  P5/g : ",[276169531104/g,-159446553408/g]);
print("  norm of (276169531104 - 159446553408 sqrt3) = ",276169531104^2-3*159446553408^2);
print("  factor of norm: ",factor(276169531104^2-3*159446553408^2));
kap=2^(1/6)*3^(1/4)*P5abs*(2+s3)^7/2^18;
print("kappa (closed form) = ",precision(kap,60));
kapnum=27.867359229162067584492644331603077620480318677886350178353849679017394885134;
print("kappa (fold)        = ",kapnum);
print("ratio-1             = ",precision(kap/kapnum-1,10));
K7=kap*gamma(1/3)^12/Pi^(19/2);
print("K7 (closed form)    = ",precision(K7,60));
k6=kap^6;
print("kappa^6 = ",precision(k6,50));
print("  algdep(kappa^6,2) = ",algdep(precision(k6,350),2));
e6=3*s3*P5abs^6*(2+s3)^42/2^107;
print("  exact kappa^6 = 3 sqrt3 |P5|^6 (2+sqrt3)^42 / 2^107 = ",precision(e6,50));
print("  check ",precision(e6/k6-1,10));
\\ rational and sqrt3 parts of kappa^6
a=(e6+3*s3*(-P5abs)^6*(2-s3)^42/2^107)/2;
print("kappa^6 exact as A + B sqrt3:");
X=P5abs; Y=2+s3;
pp=Mod(276169531104-159446553408*w,w^2-3);
qq=Mod(2+w,w^2-3);
val=3*w*(-pp)^6*qq^42/2^107;
print("  kappa^6 = ",lift(Mod(3*w,w^2-3)*(-pp)^6*qq^42)/2^107);
print("  minimal polynomial of kappa^6: ",minpoly(Mod(3*w,w^2-3)*(-pp)^6*qq^42/2^107));
print("  minimal polynomial of kappa (deg 12): ");
mp=minpoly(Mod(3*w,w^2-3)*(-pp)^6*qq^42/2^107);
print("   subst y^6: ",subst(mp,x,y^6));
quit;
