default(parisize,"16G");
default(realprecision,500);
M=800;
et(k)=prod(m=1,M\k+1,1-'q^(k*m)+O('q^(M+2)));
D(s)='q*deriv(s,'q);
ev(s,z)=subst(truncate(s),'q,z);
h=et(1)^3*et(4)*et(6)^2/(et(2)^2*et(3)*et(12)^3)/'q;
v=1/h;
x=h/((h+3)*(h+4));
E8(k)=1+480*sum(m=1,M\k+1,sigma(m,7)*'q^(k*m))+O('q^(M+2));
Phi=(E8(1)-572*E8(2)+11583*E8(3)-36608*E8(4)+46332*E8(6)-20736*E8(12))/480;
Dx=D(x);
U=Phi/Dx;
qc=exp(-Pi/sqrt(3));
s3=sqrt(3);
xp=7-4*s3;
print("=== basic checks at tau_c = i/sqrt(12), q_c = ",precision(qc,25));
print("x(q_c) - x_+       = ",precision(ev(x,qc)-xp,10));
print("Dx(q_c)            = ",precision(ev(Dx,qc),10));
print("h(q_c) - 2sqrt3    = ",precision(ev(h,qc)-2*s3,10));
print("v(q_c) - 1/(2sqrt3)= ",precision(ev(v,qc)-1/(2*s3),10));
print("Phi(q_c)           = ",precision(ev(Phi,qc),10));
DPhi=ev(D(Phi),qc); D2x=ev(D(D(x)),qc); Dv=ev(D(v),qc); Dh=ev(D(h),qc);
Uc=ev(U,qc); DUc=ev(D(U),qc);
print("DPhi(tau_c)        = ",precision(DPhi,40));
print("D2x(tau_c)         = ",precision(D2x,40));
print("Dv(tau_c)          = ",precision(Dv,40));
print("U(tau_c)           = ",precision(Uc,40));
print("U(tau_c)-DPhi/D2x  = ",precision(Uc-DPhi/D2x,10));
print("DU - (6sqrt12/(4Pi))U = ",precision(DUc-6*sqrt(12)/(4*Pi)*Uc,10));
print("Dh + 12*Dv         = ",precision(Dh+12*Dv,10));
xpp=(168-97*s3)/3;
print("x''(h_c) exact (168-97sqrt3)/3 = ",precision(xpp,30));
print("  check -x'' = x_+^2/sqrt3 : ",precision(-xpp-xp^2/s3,10));
print("D2x - x''*Dh^2     = ",precision(D2x-xpp*Dh^2,10));
print("x_+/(-x'') - (12+7sqrt3) = ",precision(xp/(-xpp)-(12+7*s3),10));
K7fold=6*sqrt(12)/(8*Pi^(3/2))*abs(Uc)*sqrt(2*xp/(-D2x));
print("=== fold formula");
print("K7 (fold)          = ",precision(K7fold,60));
print("K7^2 check         = ",precision(K7fold^2-xp*(6*sqrt(12)/(4*Pi)*Uc)^2/(2*Pi*(-D2x)),10));
print("=== CM identifications");
W2=gamma(1/3)^6/Pi^4;
print("(Dv/W2)^3          = ",precision((Dv/W2)^3,40));
print("  minus 3(45+26sqrt3)/2^17 = ",precision((Dv/W2)^3-3*(45+26*s3)/2^17,10));
P5=2025*(490730*s3-849969)*(1152*s3-2016)/25;
print("P5 (census product)= ",precision(P5,40));
print("DPhi/(Dv)^5        = ",precision(DPhi/Dv^5,40));
print("  ratio to P5      = ",precision(DPhi/Dv^5/P5,40));
print("  algdep deg 2 of DPhi/(Dv)^5: ",algdep(precision(DPhi/Dv^5,200),2));
print("  lindep [DPhi/Dv^5,1,sqrt3] : ",lindep(vector(3,j,precision([DPhi/Dv^5,1,s3][j],200))));
print("=== closed form assembly");
kap=K7fold*Pi^(19/2)/gamma(1/3)^12;
print("kappa = K7 pi^{19/2}/Gamma(1/3)^12 = ",precision(kap,60));
{foreach([2,3,4,6,12,24],dd, print("  algdep(kappa,",dd,") = ",algdep(precision(kap,300),dd)));}
print("  algdep(kappa^3,2) = ",algdep(precision(kap^3,300),2));
print("  algdep(kappa^6,2) = ",algdep(precision(kap^6,300),2));
print("  algdep(kappa^12,2)= ",algdep(precision(kap^12,300),2));
print("  algdep(kappa^2,4) = ",algdep(precision(kap^2,300),4));
print("  algdep(kappa^6,4) = ",algdep(precision(kap^6,300),4));
write("foldvals.txt",[precision(K7fold,400),precision(Uc,400),precision(DPhi,400),precision(D2x,400),precision(Dv,400),precision(kap,400)]);
quit;
