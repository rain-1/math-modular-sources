default(parisize,"24G");
NQ=430;
NC=400;
et(k)=prod(m=1,NQ\k+1,1-'q^(k*m)+O('q^(NQ+2)));
gettime();
h=et(1)^3*et(4)*et(6)^2/(et(2)^2*et(3)*et(12)^3)/'q;
x=h/((h+3)*(h+4));
g=vector(NQ,m,sum(i=1,6,my(dv=[1,2,3,4,6,12][i],cv=[1,-572,11583,-36608,46332,-20736][i]);if(m%dv==0,cv*sigma(m\dv,7),0)));
Phi=sum(m=1,NQ,g[m]*'q^m)+O('q^(NQ+1));
Psi=sum(m=1,NQ,(g[m]/m^7)*'q^m)+O('q^(NQ+1));
Dx='q*deriv(x,'q);
U=Phi/Dx;
print("setup: ",gettime()," ms");
Qx=serreverse(x+O('q^(NC+2)));
print("serreverse: ",gettime()," ms");
A=subst(U+O('q^(NC+2)),'q,Qx);
print("subst U: ",gettime()," ms");
PsiX=subst(Psi+O('q^(NC+2)),'q,Qx);
print("subst Psi: ",gettime()," ms");
B=A*PsiX;
print("mult: ",gettime()," ms");
cn=vector(NC+1,i,polcoeff(A,i-1));
dn=vector(NC+1,i,polcoeff(B,i-1));
write("cn400.txt",cn);
write("dn.txt",dn);
print("d_0..d_5 = ",vector(6,i,dn[i]));
DD=vector(NC+1); DD[1]=1;
for(n=1,NC,DD[n+1]=lcm(DD[n],n));
print("D_n^7 d_n integral all n<=400? ",vecmin(vector(NC+1,i,denominator(DD[i]^7*dn[i])==1)));
sh=vector(NC+1,i,denominator(DD[i]^6*dn[i])==1);
print("D_n^6 d_n integral count (n<=400): ",sum(i=1,NC+1,sh[i]),"  first n where it FAILS: ",vecmin(vector(NC+1,i,if(sh[i],10^6,i-1))));
print("xi check: (1728/209)*d_400/c_400 vs zeta(7): ");
default(realprecision,620);
xi=(209/1728)*zeta(7);
print("digits at n=400: ",-log(abs(1.0*dn[NC+1]/cn[NC+1]-xi))/log(10));
quit;
