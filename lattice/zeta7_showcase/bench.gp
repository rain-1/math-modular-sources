default(parisize,"8G");
NQ=200;
et(k)=prod(m=1,NQ\k+1,1-'q^(k*m)+O('q^(NQ+2)));
gettime();
h=et(1)^3*et(4)*et(6)^2/(et(2)^2*et(3)*et(12)^3)/'q;
x=h/((h+3)*(h+4));
print("h,x built: ",gettime()," ms");
print("x = ",x+O('q^8));
E8(k)=1+480*sum(m=1,NQ\k+1,sigma(m,7)*'q^(k*m))+O('q^(NQ+2));
Phi=(E8(1)-572*E8(2)+11583*E8(3)-36608*E8(4)+46332*E8(6)-20736*E8(12))/480;
print("Phi built: ",gettime()," ms");
print("Phi = ",Phi+O('q^8));
Dx='q*deriv(x,'q);
U=Phi/Dx;
print("U(q) = ",U+O('q^8));
print("U built: ",gettime()," ms");
Qx=serreverse(x+O('q^(NQ+1)));
print("serreverse: ",gettime()," ms");
A=subst(U+O('q^(NQ+1)),'q,Qx);
print("subst: ",gettime()," ms");
print("c_0..c_8 = ",vector(9,i,polcoeff(A,i-1)));
print("log10|c_190| = ",log(abs(1.0*polcoeff(A,190)))/log(10));
quit;
