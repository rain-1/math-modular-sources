default(parisize,"16G");
default(linewrap,0);
BASE="/tmp/claude-1000/-home-ubuntu-code-math-modular-sources/9a849c0a-95f8-4d19-b342-98033d0d9c03/scratchpad/zeta7/";
CN=read(concat(BASE,"cn.txt"));
vfy(QV,r,nm)=my(bad=0,md=0);for(nn=r+1,900,my(s=0);for(j=0,r,s=s+subst(QV[j+1],n,nn)*CN[nn-j+1]);if(s!=0,bad=bad+1));for(j=1,r+1,for(k=0,poldegree(QV[j],n),md=max(md,#Str(abs(polcoeff(QV[j],k,n))))));print(nm," #terms=",r+1," deg=",vecmax(vector(r+1,i,poldegree(QV[i],n)))," maxdigits=",md," EXACT-verify-failures(n=",r+1,"..900)=",bad);
read(concat(BASE,"rec_23_10.gp"));
vfy(PV,23,"rec_23_10.gp PV   ");
vfy(PVB1,23,"rec_23_10.gp PVB1 ");
vfy(PVB2,23,"rec_23_10.gp PVB2 ");
write(concat(BASE,"P0P1_23_10.txt"),Str("P0=",PV[1]));
write(concat(BASE,"P0P1_23_10.txt"),Str("P1=",PV[2]));
read(concat(BASE,"rec_17_15.gp"));
vfy(PV,17,"rec_17_15.gp PV   ");
vfy(PVALT,17,"rec_17_15.gp PVALT");
vfy(PVB1,17,"rec_17_15.gp PVB1 ");
write(concat(BASE,"P0P1_17_15.txt"),Str("P0=",PV[1]));
write(concat(BASE,"P0P1_17_15.txt"),Str("P1=",PV[2]));
read(concat(BASE,"rec_19_13.gp"));
vfy(PV,19,"rec_19_13.gp PV   ");
write(concat(BASE,"P0P1_19_13.txt"),Str("P0=",PV[1]));
write(concat(BASE,"P0P1_19_13.txt"),Str("P1=",PV[2]));
read(concat(BASE,"rec_19_13_constres.gp"));
vfy(PV,19,"rec_19_13_constres.gp PV");
write(concat(BASE,"P0P1_19_13_constres.txt"),Str("P0=",PV[1]));
write(concat(BASE,"P0P1_19_13_constres.txt"),Str("P1=",PV[2]));
print("ROUNDTRIP DONE");
quit;
