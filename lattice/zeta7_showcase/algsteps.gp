default(realprecision,60);
w=Mod(x,x^2-3);
P5=276169531104-159446553408*w;
print("P5 = ",lift(P5));
print("P5 = -2^5*3^6*sqrt3*(6834986-3946181*sqrt3)? ",lift(P5+2^5*3^6*w*(6834986-3946181*w))==0);
print("(6834986-3946181 w)*(2+w)^7 = ",lift((6834986-3946181*w)*(2+w)^7));
print("(2+w)^7 = ",lift((2+w)^7));
print("(2+w)^5 = ",lift((2+w)^5),"   = x_+^(-5/2)");
print("norm(739-356w) = ",lift(Mod(739-356*x,x^2-3)*Mod(739+356*x,x^2-3)));
print("x''(h_c)=(168-97w)/3 ; -x'' - x_+^2/sqrt3 : ",lift(-(168-97*w)/3-(7-4*w)^2/w*Mod(1,x^2-3)));
print("  (uses 1/sqrt3 = sqrt3/3): ",lift(-(168-97*w)/3-(7-4*w)^2*w/3));
print("x_+/(-x'') = ",lift((7-4*w)*3/(97*w-168)));
print("(45+26w) = sqrt3*(2+w)^3 ? ",lift(45+26*w-w*(2+w)^3)==0);
print("3*(45+26w)/2^17 = 3^(3/2)(2+w)^3/2^17 -> (Dv/Om^2) = sqrt3 (2+w)/2^(17/3)");
default(realprecision,400);
s3=sqrt(3);
Om2=gamma(1/3)^6/Pi^4;
Dv=s3*(2+s3)/2^(17/3)*Om2;
fv=read("foldvals.txt");
print("Dv closed vs numeric: ",precision(Dv/fv[5]-1,10));
K7=(s3/(1152*Pi^(3/2)))*abs(276169531104-159446553408*s3)*Dv^2*sqrt(2*(7-4*s3))/((97*s3-168)/3)^(3/2);
print("K7 from assembled algebra = ",precision(K7,50));
print("   vs fold value: ",precision(K7/fv[1]-1,10));
kap=3^(27/4)*(739-356*s3)/2^(77/6);
print("kappa = 3^(27/4)(739-356 sqrt3)/2^(77/6) = ",precision(kap,60));
print("K7 = kappa*Gamma(1/3)^12/Pi^(19/2) = ",precision(kap*gamma(1/3)^12/Pi^(19/2),60));
print("kappa^6 = 3^40*sqrt3*(739-356 sqrt3)^6/2^77 : ",precision(kap^6/(3^40*s3*(739-356*s3)^6/2^77)-1,10));
quit;
