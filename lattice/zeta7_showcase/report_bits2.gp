default(parisize,"12G");
default(linewrap,0);
BASE="/tmp/claude-1000/-home-ubuntu-code-math-modular-sources/9a849c0a-95f8-4d19-b342-98033d0d9c03/scratchpad/zeta7/";
hd(x,k)=my(s=Str(abs(x)),v=Vec(s),M=#v,a="",b="");for(i=1,min(k,M),a=concat(a,v[i]));for(i=max(1,M-k+1),M,b=concat(b,v[i]));concat(concat(concat(if(x<0,"-",""),a),concat("...[",concat(Str(M),"dig]..."))),b);
sm(x)=my(s=1,y=abs(x),e);forprime(q=2,100000,e=0;while(y%q==0,y=y/q;e=e+1);if(e>0,s=s*q^e));[factor(s),#Str(y)];
TP=(L+1)^7*(L^2-14*L+1)^6;
tv=vector(20,i,polcoeff(TP,20-i));
read(concat(BASE,"rec_19_13.gp"));
pj=vector(20,i,polcoeff(PV[i],13,n));
c0=pj[1];
ok=1;
for(i=1,20,if(pj[i]!=c0*tv[i],ok=0));
print("(19,13) canonical: p_j = c0*t_j exactly for all j? ",ok);
print("  c0 = ",hd(c0,30));
print("  c0 smooth part <1e5: ",sm(c0));
print("  P_0 lead ",hd(polcoeff(PV[1],13,n),24));
print("  P_1 lead ",hd(polcoeff(PV[2],13,n),24));
print("  P_1 const term ",hd(polcoeff(PV[2],0,n),24));
read(concat(BASE,"rec_23_10.gp"));
print("(23,10) P_0 lead ",hd(polcoeff(PV[1],10,n),24),"  P_1 lead ",hd(polcoeff(PV[2],10,n),24));
read(concat(BASE,"rec_17_15.gp"));
print("(17,15) P_0 lead ",hd(polcoeff(PV[1],15,n),24),"  P_1 lead ",hd(polcoeff(PV[2],15,n),24));
quit;
