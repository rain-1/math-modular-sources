default(parisize,2000000000);
default(realprecision,120);
N=240;
et(k)=eta(q^k+O(q^(N+3)));
d12=[1,2,3,4,6,12]; c12=[1,-572,11583,-36608,46332,-20736];
g=vector(N,m,sum(i=1,6,if(m%d12[i]==0,c12[i]*sigma(m\d12[i],7),0)));
Phi=sum(m=1,N,g[m]*q^m)+O(q^(N+1));
Psi=sum(m=1,N,(g[m]/m^7)*q^m)+O(q^(N+1));
xi=(209/1728)*zeta(7);
h=et(1)^3*et(4)*et(6)^2/(et(2)^2*et(3)*et(12)^3)/q;
x=h/((h+3)*(h+4));
print("x = ",x+O(q^6));
Dx=q*deriv(x,q);
Fp=Phi/Dx;
print("F' = ",Fp+O(q^5));
Qx=serreverse(x);
A=subst(Fp,q,Qx); B=A*subst(Psi,q,Qx);
M=N-8;
cn=vector(M+1,i,polcoeff(A,i-1)); dn=vector(M+1,i,polcoeff(B,i-1));
print("c_0..c_8 = ",vector(9,i,cn[i]));
print("c_n integral to n=",M,"? ",vecmax(vector(M+1,i,denominator(cn[i])))==1);
print("d_1..d_4 = ",vector(4,i,dn[i+1]));
dd=vector(M+1); dd[1]=1; for(n=1,M,dd[n+1]=lcm(dd[n],n));
print("D_n^7 d_n integral? ",vecmin(vector(M+1,i,denominator(dd[i]^7*dn[i])==1)));
print("D_n^6 d_n integral? ",vecmin(vector(M+1,i,denominator(dd[i]^6*dn[i])==1)));
for(i=1,6,my(n=[20,50,100,150,200,M][i]); print("n=",n,"  |c_n|^(1/n)=",abs(1.0*cn[n+1])^(1/n),"  |d/c-xi|^(1/n)=",abs(1.0*dn[n+1]/cn[n+1]-xi)^(1/n),"  digits=",-log(abs(1.0*dn[n+1]/cn[n+1]-xi))/log(10)));
print("7+4sqrt3 = ",7+4*sqrt(3),"   7-4sqrt3 = ",7-4*sqrt(3));
print("lindep(d_M/c_M, zeta7): ",lindep([1.0*dn[M+1]/cn[M+1],zeta(7)]));
print("sign pattern c_n (n=180..190): ",vector(11,i,sign(cn[180+i])));
quit;
