default(parisize,"16G");
default(realprecision,700);
M=1100;
et(k)=prod(m=1,M\k+1,1-'q^(k*m)+O('q^(M+2)));
D(s)='q*deriv(s,'q);
ev(s,z)=subst(truncate(s),'q,z);
h=et(1)^3*et(4)*et(6)^2/(et(2)^2*et(3)*et(12)^3)/'q;
v=1/h;
x=h/((h+3)*(h+4));
E8(k)=1+480*sum(m=1,M\k+1,sigma(m,7)*'q^(k*m))+O('q^(M+2));
Phi=(E8(1)-572*E8(2)+11583*E8(3)-36608*E8(4)+46332*E8(6)-20736*E8(12))/480;
qc=exp(-Pi/sqrt(3)); s3=sqrt(3);
DPhi=ev(D(Phi),qc); Dv=ev(D(v),qc);
P5=276169531104-159446553408*s3;
print("relative error DPhi/(Dv)^5 vs P5 : ",precision(DPhi/Dv^5/P5-1,10));
W2=gamma(1/3)^6/Pi^4;
print("relative error (Dv/W2)^3 vs 3(45+26s3)/2^17 : ",precision((Dv/W2)^3/(3*(45+26*s3)/2^17)-1,10));
U=Phi/D(x);
Uc=ev(U,qc); D2x=ev(D(D(x)),qc);
K7f=6*sqrt(12)/(8*Pi^(3/2))*abs(Uc)*sqrt(2*(7-4*s3)/(-D2x));
K7c=3^(27/4)*(739-356*s3)/2^(77/6)*gamma(1/3)^12/Pi^(19/2);
print("K7 closed/fold - 1 : ",precision(K7c/K7f-1,10));
print("Dh + 12 Dv : ",precision(ev(D(h),qc)+12*Dv,10));
print("D2x - x''(h_c) Dh^2 (relative): ",precision(D2x/((168-97*s3)/3*ev(D(h),qc)^2)-1,10));
print("DU - (6 sqrt12/(4Pi)) U (relative): ",precision(ev(D(U),qc)/(6*sqrt(12)/(4*Pi)*Uc)-1,10));
quit;
