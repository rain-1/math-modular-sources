default(parisize,"24G");
default(linewrap,0);
read("/tmp/claude-1000/-home-ubuntu-code-math-modular-sources/9a849c0a-95f8-4d19-b342-98033d0d9c03/scratchpad/zeta7/analyze_lib.gp");
CN=read(concat(BASE,"cn.txt"));
NC=900;
verifyrec(PV,r)=my(bad=0);for(nn=r+1,NC,my(s=0);for(j=0,r,s=s+subst(PV[j+1],n,nn)*CN[nn-j+1]);if(s!=0,bad=bad+1));bad;
distinguished(B,r,D,a,b)=my(k=#B,CH=vector(k,i,chiof(B[i],r,D)),md=(L+1)^a*(L^2-14*L+1)^b,MM,kk,v);MM=matrix(a+2*b,k,x,y,polcoeff(CH[y]%md,x-1));kk=matker(MM);if(#kk!=1,error("not 1-dim"));v=vector(#B[1],i,sum(y=1,k,kk[y,1]*B[y][i]));prim(v);
report(v,r,D,nm)=my(PV=tovec2pol(v,r,D),ch=chiof(v,r,D),cc,co);print("== ",nm," ==");print("  max coeff digits: ",maxdig(v));print("  EXACT verify n=",r+1,"..900 residual-count: ",verifyrec(PV,r));cc=content(ch);print("  chi content digits: ",#Str(abs(numerator(cc))));co=ch/cc;print("  chi/content = ",factor(co));print("  P_0 factored:");print(factor(PV[1]));print("  P_1 = ");print(PV[2]);return(PV);
read(concat(BASE,"rec_23_10_raw.gp"));
B2310=BVL;
v2310=distinguished(B2310,23,10,8,3);
PV2310=report(v2310,23,10,"(23,10) distinguished chi=(L+1)^8(L^2-14L+1)^3*[deg 9]");
write(concat(BASE,"rec_23_10.gp"),Str("PV=",PV2310));
write(concat(BASE,"rec_23_10.gp"),Str("PVB1=",tovec2pol(B2310[1],23,10)));
write(concat(BASE,"rec_23_10.gp"),Str("PVB2=",tovec2pol(B2310[2],23,10)));
read(concat(BASE,"rec_17_15_raw.gp"));
B1715=BVL;
v1715=distinguished(B1715,17,15,7,4);
PV1715=report(v1715,17,15,"(17,15) distinguished chi=(L+1)^7(L^2-14L+1)^4*[deg 2]");
w1715=distinguished(B1715,17,15,9,3);
PW1715=tovec2pol(w1715,17,15);
print("  ALT (9,3) max digits ",maxdig(w1715)," verify ",verifyrec(PW1715,17)," chi/content=",factor(chiof(w1715,17,15)/content(chiof(w1715,17,15))));
write(concat(BASE,"rec_17_15.gp"),Str("PV=",PV1715));
write(concat(BASE,"rec_17_15.gp"),Str("PVALT=",PW1715));
write(concat(BASE,"rec_17_15.gp"),Str("PVB1=",tovec2pol(B1715[1],17,15)));
write(concat(BASE,"rec_17_15.gp"),Str("PVB2=",tovec2pol(B1715[2],17,15)));
write(concat(BASE,"rec_17_15.gp"),Str("PVB3=",tovec2pol(B1715[3],17,15)));
read(concat(BASE,"rec_19_13_raw.gp"));
v1913=prim(BVL[1]);
PV1913=report(v1913,19,13,"(19,13) canonical chi=(L+1)^7(L^2-14L+1)^6");
write(concat(BASE,"rec_19_13.gp"),Str("PV=",PV1913));
print("FILES WRITTEN");
quit;
