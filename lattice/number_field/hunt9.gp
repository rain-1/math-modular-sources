alghit(zz, dmax, ht) = { for(dd=1,dmax, my(pp=algdep(zz,dd)); if(poldegree(pp)>0 && vecmax(abs(Vec(pp))) < ht, my(rt=polroots(pp)); my(mm=vecmin(vector(#rt,ii,abs(rt[ii]-zz)))); if(mm < 1e-120, return([dd,pp,mm])))); 0; }
sweep(tag, val, gg, gn, amin, amax, Mv, Mn) = { my(cnt=0);
  for(aa=amin,amax, for(bb=-6,6, for(mi=1,#Mv,
    my(mo = gg^aa * Pi^bb * Mv[mi]); my(zz = val/mo); my(h = alghit(zz, 10, 10^8));
    if(h != 0, print("  HIT ", tag, " / (",gn,"^",aa," Pi^",bb," ",Mn[mi],") deg ",h[1]," ",h[2]," resid ",h[3]); cnt++);
  )));
  print(tag," [",gn,"]: ",cnt," hits"); }
M2 = [1, L3c, Catalan, log(2), log(3), zeta(3), Lf12]; N2 = ["1","L(chi-3,2)","Catalan","log2","log3","zeta3","Lf12"];
