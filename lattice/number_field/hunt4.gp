xi2 = 0.1642087341590574584714225970206947065830122999536287405694316515422586105676807745518762686902555647720236146720735800852953327485050302342736826060045161009106544716484284489377941968395761197077123295366087484842016287741923684399374479825889396610 - 0.2369659751659112010711143299806665676669665318863734518080024379160442279419310559148346593990524891514289658806059918517094079894759328173258155337192594168909099387369602162580142247035701450032542277433112273060653991607390105577213119189860336177*I;
Om3 = gamma(1/3)^3/(2^(4/3)*Pi);
Om4 = gamma(1/4)^2/(2*sqrt(2*Pi));
Lf7 = 0.4672117688843731239421100514130912617241085499597108770877440238359901454261436221731572515501991028333638344410110051851727501069899276193186479864768927564583899525545198199861384; 
L7c = 1.151925470544491047101692397320549964797821404686566914083968636166124163454591547556677519062972125347936166183106402754620952480049849341395768674128283705905571705737950374176287;
L3c = 0.781302412896486296867187429624092356365134336545285420222100062966886984651618218092869570832209861021042350256509035769;
Lf12= 0.7372929961855962401764261978022936979609191432765291852228688851129961062186382156282802752799321039885928556777635;
mkset(Om, alist, klist, algs, algn) = { my(V=List(), N=List()); for(i=1,#alist, for(j=1,#klist, for(m=1,#algs, listput(V, Om^alist[i]*Pi^klist[j]*algs[m]); listput(N, Str("Om^",alist[i]," Pi^",klist[j]," * ",algn[m]))))); [Vec(V),Vec(N)]; }
alg1 = [1, sqrt(3), sqrt(7), sqrt(21), 3^(1/3), 3^(2/3), 7^(1/3), 7^(2/3), Lf7, sqrt(7)*Lf7, L7c, sqrt(3)*L7c];
an1  = ["1","s3","s7","s21","3^(1/3)","3^(2/3)","7^(1/3)","7^(2/3)","Lf7","s7*Lf7","L(chi-7,2)","s3*L(chi-7,2)"];
alg2 = [1, sqrt(2), sqrt(3), sqrt(6), 2^(1/4), 3^(1/4), 6^(1/4), Lf12, sqrt(3)*Lf12, L3c, sqrt(3)*L3c, 1];
an2  = ["1","s2","s3","s6","2^(1/4)","3^(1/4)","6^(1/4)","Lf12","s3*Lf12","L(chi-3,2)","s3*L(chi-3,2)","1b"];
S1 = mkset(Om3, [-6,-4,-3,-2,-1,0,1,2,3,4,6], [-4,-3,-2,-1,0,1,2,3,4], alg1, an1);
S2 = mkset(Om4, [-8,-6,-4,-3,-2,-1,0,1,2,3,4,6,8], [-4,-3,-2,-1,0,1,2,3,4], alg2, an2);
scan2(tag, val, BB) = { my(V=BB[1], N=BB[2], hits=0);
  for(i=1,#V, my(r = val/V[i], q = bestappr(r, 10^13));
    if(type(q)=="t_INT" || type(q)=="t_FRAC", my(res=abs(r-q)); if(res < 1e-150, print("  HIT2 ", tag, " = (", q, ") * ", N[i], "  resid ", res); hits++)));
  print(tag, ": ", hits, " 2-term hits / ", #V); }
print("##### 2-TERM #####");
scan2("Re(xi1)", real(xi1), S1); scan2("Im(xi1)", imag(xi1), S1);
scan2("Re(th1)", real(th1), S1); scan2("Im(th1)", imag(th1), S1);
scan2("Re(xi2)", real(xi2), S2); scan2("Im(xi2)", imag(xi2), S2);
