default(parisizemax, 4000000000);
w = Mod(y, y^2-y-1); s5 = 2*w-1;
co(e) = my(p=lift(e)); [polcoeff(p,0), polcoeff(p,1)];
isint(e) = my(v=co(e)); (denominator(v[1])==1) && (denominator(v[2])==1);
A = 124+55*s5; B = 34+15*s5;
Pn(n) = (A*n*(n+1) + B)*(2*n+1);
NMAX = 320;
dd = vector(NMAX+2); dd[1]=1; dd[2]=Pn(0)*dd[1];
for(n=1, NMAX, dd[n+2] = (Pn(n)*dd[n+1] - n^3*dd[n])/(n+1)^3);
d1=co(dd[2]); d2=co(dd[3]); d3=co(dd[4]);
print("d_1 = ", d1[1]+d1[2]/2, " + ", d1[2]/2, "*sqrt5");
print("d_2 = ", d2[1]+d2[2]/2, " + ", d2[2]/2, "*sqrt5");
print("d_3 = ", d3[1]+d3[2]/2, " + ", d3[2]/2, "*sqrt5");
cc = vector(NMAX+2); cc[1]=0*w; cc[2]=1+0*w;
for(n=1, NMAX, cc[n+2] = (Pn(n)*cc[n+1] - n^3*cc[n])/(n+1)^3);
c1=co(cc[3]); print("c_2 = ", c1[1]+c1[2]/2, " + ", c1[2]/2, "*sqrt5");
NF = 200;
L = vector(NF+1); L[1]=1; for(n=1,NF, L[n+1]=lcm(L[n],n));
firstbad(k) = my(bad=-1); for(n=1,NF, if(!isint(L[n+1]^k*cc[n+1]), bad=n; break)); bad;
for(k=0,5, print("  k=",k," : first n<=",NF," with lcm(1..n)^k c_n non-integral = ", firstbad(k)));
