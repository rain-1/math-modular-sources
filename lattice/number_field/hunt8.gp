default(realprecision, 130);
read("theta_gp.txt");
xi1 = 0.067867219542878261666469989645637217931570579747852538116276795998732932403877546004724369041310641588412773833013382546918161055928002919785698425922322807203506666340754775240784953737248452562335230353644074204414449913616769760503369573238073620 - 0.069078199633222255146707997907434919190717858084124595387400135093174885395783326593391458948201925776472676582969146457126719007608504977064198036072350718646756337719383442066327175406105993681094393018773964178926316295132471505359967521027998840*I;
xi2 = 0.164208734159057458471422597020694706583012299953628740569431651542258610567680774551876268690255564772023614672073580085295332748505030234273682606004516100910654471648428448937794196839576119707712329536608748484201628774192368439937447982588939661 - 0.236965975165911201071114329980666567666966531886373451808002437916044227941931055914834659399052489151428965880605991851709407989475932817325815533719259416890909938736960216258014224703570145003254227743311227306065399160739010557721311918986033617*I;
g3 = gamma(1/3); g4 = gamma(1/4);
mkB(gg, alist, blist, p1, e1, p2, e2) = { my(V=List(), N=List()); for(i=1,#alist, for(j=1,#blist, for(c=1,#e1, for(d=1,#e2, listput(V, gg^alist[i]*Pi^blist[j]*p1^e1[c]*p2^e2[d]); listput(N, Str("G^",alist[i],"*Pi^",blist[j],"*",p1,"^",e1[c],"*",p2,"^",e2[d])))))); [Vec(V),Vec(N)]; }
B2 = mkB(g4, [-8,-4,0,4,8], [-3,-2,-1,0,1,2,3], 2, [0,1/4,1/2,3/4], 3, [0,1/4,1/2,3/4]);
B1 = mkB(g3, [-9,-6,-3,0,3,6,9], [-3,-2,-1,0,1,2,3], 3, [0,1/3,1/2], 7, [0,1/3,1/2]);
pairs(tag, val, BB) = { my(V=BB[1], N=BB[2], cnt=0);
  print("scanning ", tag, " over ", #V, " basis elements");
  for(i=1,#V, for(j=i+1,#V,
    my(w = lindep([val, V[i], V[j]]));
    if(w != 0 && w[1] != 0 && vecmax(abs(w)) < 10^7,
      my(res = abs(w[1]*val + w[2]*V[i] + w[3]*V[j]));
      if(res < 1e-100, print("  3HIT ", tag, ": ", w, " * [", tag, ", ", N[i], ", ", N[j], "] resid ", res); cnt++));
  ));
  print(tag, ": ", cnt, " three-term hits"); }
pairs("Re(xi2)", real(xi2), B2);
pairs("Re(xi1)", real(xi1), B1);
pairs("Im(xi1)", imag(xi1), B1);
