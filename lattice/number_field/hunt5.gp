L3c = 0.7813024128964862968671874296240923563651343365452854202221000629668869846516182180928695708322098610210423502565090357688658705524403079992607844199895749307569672130980859321609533643863395747672858397703255158985647770912428899241002498188853713088;
Lf12= 0.73729299618559624017642619780229369796091914327652918522286888511299610621863821562828027527993210398859285567776353;
alghit(x, dmax, ht) = { for(d=1,dmax, my(p=algdep(x,d)); if(poldegree(p)>0 && vecmax(abs(Vec(p))) < ht, my(rt=polroots(p)); my(m=vecmin(vector(#rt,i,abs(rt[i]-x)))); if(m < 1e-120, return([d,p,m])))); 0; }
sweep(tag, val, Om, Lv, Ln) = { my(cnt=0);
  for(k6=-24,24, my(j=k6/6); for(kk=-4,4, for(li=1,#Lv,
    my(m = Om^j * Pi^kk * Lv[li]); my(x = val/m); my(h = alghit(x, 6, 10^10));
    if(h != 0, print("  ALG-HIT ", tag, " / (Om^",j," Pi^",kk," ",Ln[li],") : deg ",h[1],"  minpoly ",h[2],"  resid ",h[3]); cnt++);
  )));
  print(tag, ": ", cnt, " algebraic hits"); }
Lv1 = [1, Lf7, L7c, Lf7*L7c]; Ln1 = ["1","Lf7","L7c","Lf7*L7c"];
Lv2 = [1, Lf12, L3c, Lf12*L3c]; Ln2 = ["1","Lf12","L3c","Lf12*L3c"];
sweep("xi1", xi1, Om3, Lv1, Ln1);
sweep("Re(xi1)", real(xi1), Om3, Lv1, Ln1);
sweep("Im(xi1)", imag(xi1), Om3, Lv1, Ln1);
sweep("th1", th1, Om3, Lv1, Ln1);
sweep("xi2", xi2, Om4, Lv2, Ln2);
sweep("Re(xi2)", real(xi2), Om4, Lv2, Ln2);
sweep("Im(xi2)", imag(xi2), Om4, Lv2, Ln2);
sweep("th2", th2, Om4, Lv2, Ln2);
sweep("xi2/Om3basis", xi2, Om3, Lv2, Ln2);
sweep("xi1/Om4basis", xi1, Om4, Lv1, Ln1);
