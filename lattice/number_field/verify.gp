default(realprecision, 250);
Im2 = 0.2369659751659112010711143299806665676669665318863734518080024379160442279419310559148346593990524891514289658806059918517094079894759328173258155337192594168909099387369602162580142247035701450032542277433112273060653991607390105577213119189860336177;
cand = gamma(1/4)^4/(2^(7/2)*3^(11/4)*Pi);
print("Im(xi2)          = ", Im2);
print("Gamma(1/4)^4/(2^(7/2) 3^(11/4) Pi) = ", cand);
print("difference       = ", Im2 - cand);
print("relative         = ", (Im2-cand)/Im2);
w = gamma(1/4)^2/(2*sqrt(2*Pi));
print("lemniscate omega = ", w);
print("omega^2/(sqrt2*3^(11/4)) - Im2 = ", w^2/(sqrt(2)*3^(11/4)) - Im2);
print("Im2^4*4*3^11 - omega^8 = ", Im2^4*4*3^11 - w^8);
print("(2/sqrt3)*G(1/4)^4/(Pi*1728^(3/4)) - Im2 = ", (2/sqrt(3))*gamma(1/4)^4/(Pi*1728^(3/4)) - Im2);
