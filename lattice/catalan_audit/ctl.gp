\p 4000
default(parisize,4000000000);
G=Catalan;
n=98; c1=-; ; ; ; ; ; ; ; ;
; ;
printf("|qG-p| = e^%.3f   log|q|=%.1f\n", log(abs(q*G-p)), log(abs(q)));
Grat = bestappr(G, 10^320);
printf("Grat = rational, denominator has %d digits; |G-Grat|=e^%.1f\n", #Str(denominator(Grat)), log(abs(G-Grat)));
r = q*Grat - p;
printf("|q*Grat - p| = e^%.3f  (nonzero: %d)  -- SAME size, but Grat is RATIONAL\n", log(abs(r)), r!=0);
printf("lower bound 1/den(Grat) = e^%.1f  <<  |q Grat - p|  => no contradiction\n", -log(denominator(Grat)));
cf=contfracpnqn(contfrac(G,700)); qq=cf[2,1]; pp=cf[1,1];
printf("CF convergent of G with log|q|=%.1f has |qG-p| = e^%.1f (vs their e^-78)\n", log(abs(qq)), log(abs(qq*G-pp)));
\q