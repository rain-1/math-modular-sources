default(parisize,"14G");
default(realprecision,200);
M = 950;
et(k)=prod(m=1,M\k+1,1-'q^(k*m)+O('q^(M+2)));
D(s)='q*deriv(s,'q);
ev(s,z)=subst(truncate(s),'q,z);
E8(k)=1+480*sum(m=1,M\k+1,sigma(m,7)*'q^(k*m))+O('q^(M+2));
h = et(1)^3*et(4)*et(6)^2/(et(2)^2*et(3)*et(12)^3)/'q;
v = 1/h;
X = 'q*et(4)^2*et(12)^2/(et(1)^2*et(3)^2);
print("x - v(1+3v)/(1+4v) = ", X - v*(1+3*v)/(1+4*v));
T = X/(16*X^2+2*X+1);
print("t - v(12v^2+7v+1)/(144v^4+120v^3+46v^2+10v+1) = ", T - v*(12*v^2+7*v+1)/(144*v^4+120*v^3+46*v^2+10*v+1));
PH = (E8(1)-572*E8(2)+11583*E8(3)-36608*E8(4)+46332*E8(6)-20736*E8(12))/480;
F = PH/D(T);
qc = exp(-Pi/sqrt(3)); s3=sqrt(3);
Dv = ev(D(v),qc); Fv = ev(F,qc); D2T = ev(D(D(T)),qc);
A1 = Fv/Dv^3; A2 = D2T/Dv^2;
print("A2 = D2t/(Dv)^2 = ", A2, "   (1152 sqrt3 - 2016)/25 = ", (1152*s3-2016)/25);
print("   diff = ", A2-(1152*s3-2016)/25);
print("A1 = F/(Dv)^3   = ", A1);
print("   lindep([A1,1,sqrt3]) = ", lindep([A1,1,s3]));
print("   lindep at 120 digits = ", lindep(vector(3,j,precision([A1,1,s3][j],120))));
print("   lindep at 80 digits  = ", lindep(vector(3,j,precision([A1,1,s3][j],80))));
{for(d=11,26, my(cols=List(),Ms,k, NC=3*d+200, U=v, GG=v^3*F/D(v)^3);
  for(j=0,d, listput(cols, Vec(truncate(U^j+O('q^(NC+1))),-(NC+1))));
  for(j=0,d, listput(cols, Vec(truncate(-GG*U^j+O('q^(NC+1))),-(NC+1))));
  Ms=Mat(vector(#cols,i,cols[i]~)); k=matker(Ms);
  if(#k>0, print("v^3 F/(Dv)^3 rational in v, degree ",d,": "); print("  P=",vector(d+1,j,k[j,1])); print("  Q=",vector(d+1,j,k[d+1+j,1])); break));}
quit;
