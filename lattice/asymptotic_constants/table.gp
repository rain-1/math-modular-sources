default(parisize,"4G");
default(realprecision,140);
s2=sqrt(2); s3=sqrt(3);
W3=gamma(1/3)^6/Pi^4; W4=gamma(1/4)^4/Pi^3;
p(x)=precision(x,32);
print("row  |  K (32 digits)");
RS=[["alpha",12,16,4],["gamma",6,17+12*s2,17-12*s2],["eps",8,12+8*s2,12-8*s2],["zeta",9,9+6*s3,9-6*s3],["s7",7,27,-1],["s10",10,16,-4],["s18",18,16,12]];
{for(i=1,#RS, my(R=RS[i],N=R[2],l1=R[3],l2=R[4], K=sqrt(N)/(2*Pi^(3/2))*sqrt(l1/(l1-l2)));
 print(R[1],"  ",p(K),"   K^2 pi^3 = ",p(K^2*Pi^3)));}
K5 = 9*(3*(45+26*s3)/2^17)^(2/3)*sqrt((7+4*s3)/(24*s3))*W3^2/sqrt(Pi);
K16 = (10021-7083*s2)/2*(2+s2)*sqrt(4+s2)/8*W4/Pi^(3/2);
K7 = (3*s3/2)*2025*(490730*s3-849969)*(3*(45+26*s3)/2^17)^(2/3)*sqrt(1/(5*(2016-1152*s3)/25))*W3^2/Pi^(3/2);
print("z5L12  ",p(K5));
print("z5L16  ",p(K16));
print("z7L12  ",p(K7));
\\ agreement with the fold-formula numbers computed from the q-series
FOLD16 = 2.0499712563401062935751009280207553319602675007961708038442352938410816215196863629969052986126983279538629482523457941989152900926750310235132041094153464001175627657837268393878099701846985127389117;
FOLD7  = 31.721520827964090772700383570287508787127452058803917818394339824162915815842912461586095666919075704272470422765273180530247374896708218391379668649445649739162991775957779624776580957430844963532731;
FOLD5  = 0.6853718484905344059514300448805424174792574891862725872930870777129152351098113315571585760248407093049855419473996641773623567027751329051042275862497041306545306189423622834094652902571845670726607666;
print("z5L12 closed/fold - 1 = ", K5/FOLD5-1);
print("z5L16 closed/fold - 1 = ", K16/FOLD16-1);
print("z7L12 closed/fold - 1 = ", K7/FOLD7-1);
print("z5L16 K pi^{9/2}/G(1/4)^4 = ", p(K16*Pi^(9/2)/gamma(1/4)^4));
print("z7L12 K pi^{19/2}/G(1/3)^12 = ", p(K7*Pi^(19/2)/gamma(1/3)^12));
print("z5L12 K pi^{17/2}/G(1/3)^12 = ", p(K5*Pi^(17/2)/gamma(1/3)^12));
quit;
