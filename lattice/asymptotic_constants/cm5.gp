default(parisize,"14G");
default(realprecision,150);
M = 500;
et(k)=prod(m=1,M\k+1,1-'q^(k*m)+O('q^(M+2)));
D(s)='q*deriv(s,'q);
ev(s,z)=subst(truncate(s),'q,z);
E4(k)=1+240*sum(m=1,M\k+1,sigma(m,3)*'q^(k*m))+O('q^(M+2));
E6(k)=1-504*sum(m=1,M\k+1,sigma(m,5)*'q^(k*m))+O('q^(M+2));
E8(k)=1+480*sum(m=1,M\k+1,sigma(m,7)*'q^(k*m))+O('q^(M+2));
rf(GG,U,d1,d2,NC)={
  my(cols=List(), Ms);
  for(j=0,d1, listput(cols, Vec(truncate(U^j+O('q^(NC+1))),-(NC+1))));
  for(j=0,d2, listput(cols, Vec(truncate(-GG*U^j+O('q^(NC+1))),-(NC+1))));
  Mat(vector(#cols,i,cols[i]~));
}
print("=== level16 zeta5: evaluate fitted R at x_c = sqrt(2)/4");
PN = [1, -26, -668, -7048, -45152, -202176, -663296, -1617408, -2889728, -3608576, -2736128, -851968, 262144];
QN = [1, 30, 420, 3640, 21792, 95040, 309760, 760320, 1394688, 1863680, 1720320, 983040, 262144];
yy = Mod('y,'y^2-2); xc = yy/4;
Pv = sum(j=1,13,PN[j]*xc^(j-1)); Qv = sum(j=1,13,QN[j]*xc^(j-1));
print("  P(x_c) = ", Pv); print("  Q(x_c) = ", Qv); print("  R(x_c) = ", Pv/Qv);
print("  numeric = ", subst(lift(Pv/Qv),'y,sqrt(2)));
print("=== level12 zeta7: push the rational fit");
X = 'q*et(4)^2*et(12)^2/(et(1)^2*et(3)^2);
T = X/(16*X^2+2*X+1);
PH = (E8(1)-572*E8(2)+11583*E8(3)-36608*E8(4)+46332*E8(6)-20736*E8(12))/480;
F = PH/D(T);
R12 = X^3*F/D(X)^3;
{for(d=15,26, my(k=matker(rf(R12,X,d,d,3*d+160))); if(#k>0, print("  degree ",d," dim ",#k); my(v=k[,1]); my(P=vector(d+1,j,v[j]), Q=vector(d+1,j,v[d+1+j])); print("  P=",P); print("  Q=",Q); my(xc4=1/4); print("  R(1/4) = ", sum(j=1,d+1,P[j]*xc4^(j-1))/sum(j=1,d+1,Q[j]*xc4^(j-1))); break));}
print("=== level12 zeta5: closed form check");
h = et(1)^3*et(4)*et(6)^2/(et(2)^2*et(3)*et(12)^3)/'q;
v = 1/h; Xz = v/(1+7*v+12*v^2);
E = (-9*E4(3)+16*E4(4))/7;
G = 7*E/(143*Xz^3+189*Xz^2+21*Xz+7);
RR = v^2*G/D(v)^2;
Rfn(z) = (1+3*z)*(1+4*z)*(1-12*z^2)/((1+6*z)^2*(1+2*z)^2);
print("  R(v) - (1+3v)(1+4v)(1-12v^2)/((1+6v)^2(1+2v)^2) = ", RR - Rfn(v));
vc = 1/(2*sqrt(3));
print("  R(v_c) = ", Rfn(vc));
eps0 = 10^(-60);
print("  R'(v_c) approx = ", (Rfn(vc+eps0)-Rfn(vc-eps0))/(2*eps0), "   (-3/2)");
qc = exp(-Pi/sqrt(3));
Dv = ev(D(v),qc); W2=gamma(1/3)^6/Pi^4;
print("  (Dv/W2)^3 - 3(45+26 sqrt3)/2^17 = ", (Dv/W2)^3 - 3*(45+26*sqrt(3))/2^17);
Kf = 9*Dv^2/sqrt(Pi)*sqrt((7+4*sqrt(3))/(24*sqrt(3)));
print("  K from closed form = ", Kf);
print("  K published        = 0.68537184849053440595143004488054241747925748918627");
print("  K sqrt(Pi)/W2^2    = ", Kf*sqrt(Pi)/W2^2);
print("  = 9 (3(45+26sqrt3)/2^17)^(2/3) sqrt((7+4sqrt3)/(24 sqrt3)) = ", 9*(3*(45+26*sqrt(3))/2^17)^(2/3)*sqrt((7+4*sqrt(3))/(24*sqrt(3))));
quit;
