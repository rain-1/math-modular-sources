default(parisize,"12G");
default(realprecision,220);
M = 900;
et(k)=prod(m=1,M\k+1,1-'q^(k*m)+O('q^(M+2)));
D(s)='q*deriv(s,'q);
ev(s,z)=subst(truncate(s),'q,z);
h = et(1)^3*et(4)*et(6)^2/(et(2)^2*et(3)*et(12)^3)/'q;
v = 1/h;
X = h/((h+3)*(h+4));
E4(k)=1+240*sum(m=1,M\k+1,sigma(m,3)*'q^(k*m))+O('q^(M+2));
E = (-9*E4(3)+16*E4(4))/7;
QQ(z) = 143*z^3+189*z^2+21*z+7;
G = 7*E/QQ(X);
print("v = ", v+O('q^8));
print("X = ", X+O('q^8));
print("X - v/(1+7v+12v^2) = ", X - v/(1+7*v+12*v^2));
print("G = ", G+O('q^8));
qc = exp(-Pi/sqrt(3));
print("q_c = exp(-2 Pi/sqrt(12)) = ", qc);
xp = 7-4*sqrt(3);
print("X(q_c) - x_+ = ", ev(X,qc)-xp);
print("DX(q_c)      = ", ev(D(X),qc));
print("v(q_c) - 1/sqrt(12) = ", ev(v,qc)-1/sqrt(12));
print("E(tau_c)     = ", ev(E,qc));
print("G(tau_c)     = ", ev(G,qc));
DG = ev(D(G),qc); D2X = ev(D(D(X)),qc);
print("DG(tau_c)    = ", DG);
print("D2X(tau_c)   = ", D2X);
Kf = sqrt(xp*DG^2/(2*Pi*(-D2X)));
print("K (fold formula) = ", Kf);
Kpub = 0.68537184849053440595143004488054241747925748918627;
print("K (published)    = ", Kpub);
print("ratio-1          = ", Kf/Kpub-1);
\\ Fricke sign of E at a generic point on |tau|=1/sqrt(12)
th = 1.9; N=12; tau = (cos(th)+I*sin(th))/sqrt(N); taup = -1/(N*tau);
q1 = exp(2*Pi*I*tau); q2 = exp(2*Pi*I*taup);
print("|q| at test point = ", abs(q1), " ", abs(q2));
print("E|_4 W_12 / E    = ", ev(E,q2)/((sqrt(N)*tau)^4*ev(E,q1)));
print("v(W tau)*v(tau)  = ", ev(v,q2)*ev(v,q1), "   1/C = ", 1/12.);
\\ CM identification
W2 = gamma(1/3)^6/Pi^4;
Dv = ev(D(v),qc);
print("Dv(tau_c)        = ", Dv);
print("(Dv/W^2)         = ", Dv/W2);
print("(Dv/W^2)^6 algdep 2: ", algdep((Dv/W2)^6,2));
print("(Dv/W^2)^3 algdep 2: ", algdep((Dv/W2)^3,2));
print("(Dv/W^2)^2 algdep 4: ", algdep((Dv/W2)^2,4));
print("K*sqrt(Pi)/W^4   = ", Kf*sqrt(Pi)/W2^2);
print("  algdep deg 6:  ", algdep(Kf*sqrt(Pi)/W2^2,6));
print("  algdep deg 12: ", algdep(Kf*sqrt(Pi)/W2^2,12));
print("K*Pi^(17/2)/Gamma(1/3)^12 = ", Kf*Pi^(17/2)/gamma(1/3)^12);
print("  algdep deg 6:  ", algdep(Kf*Pi^(17/2)/gamma(1/3)^12,6));
quit;
