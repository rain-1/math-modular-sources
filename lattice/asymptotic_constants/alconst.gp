default(realprecision,40);
RS=[["alpha",12,[1,2,3,4,6,12],[-4,4,4,-4,-4,4],9],["gamma",6,[1,2,3,6],[-5,1,-1,5],72],["eps",8,[1,2,4,8],[-4,2,-2,4],32],["zeta",9,[1,3,9],[-3,0,3],27],["s7",7,[1,7],[-4,4],49],["s10",10,[1,2,5,10],[-2,-2,2,2],25],["s18",18,[1,2,3,6,9,18],[-6,6,12,-12,-6,6],1]];
{for(i=1,#RS, my(R=RS[i],N=R[2],DL=R[3],EL=R[4],CC=R[5]);
 my(cst = prod(j=1,#DL, (N/DL[j])^EL[j]));
 print(R[1],": sum r_d = ",vecsum(EL),"  ord_inf = ",sum(j=1,#DL,DL[j]*EL[j])/24,"  prod (N/d)^{r_d} = ",cst,"  1/C^2 = ",1/CC^2, "   equal: ", cst==1/CC^2));}
quit;
