default(parisize,"16G");
default(realprecision,200);
M = 950;
et(k)=prod(m=1,M\k+1,1-'q^(k*m)+O('q^(M+2)));
D(s)='q*deriv(s,'q);
ev(s,z)=subst(truncate(s),'q,z);
E6(k)=1-504*sum(m=1,M\k+1,sigma(m,5)*'q^(k*m))+O('q^(M+2));
E8(k)=1+480*sum(m=1,M\k+1,sigma(m,7)*'q^(k*m))+O('q^(M+2));
NA=900; MPTS=18; H=35;
rich(AT,tp,N0)={
  my(ns=vector(MPTS,j,N0-H*(j-1)));
  my(kn=vector(MPTS,r,abs(polcoef(AT,ns[r]))*tp^ns[r]*ns[r]^(3/2)));
  my(s1=matsolve(matrix(MPTS,MPTS,r,s,1/ns[r]^(s-1)),kn~));
  my(s2=matsolve(matrix(MPTS-2,MPTS-2,r,s,1/ns[r]^(s-1)),vector(MPTS-2,r,kn[r])~));
  [s1[1],s2[1]];
}
print("################ level-16 zeta(5)");
X = 'q*et(2)*et(16)^2/(et(1)^2*et(8));
T = X/(8*X^2+2*X+1);
PH = -(E6(1)-85*E6(2)+1428*E6(4)-5440*E6(8)+4096*E6(16))/504;
F = PH/D(T);
QT = serreverse(T+O('q^(NA+1))); AT = subst(F+O('q^(NA+1)),'q,QT);
s2=sqrt(2); l1=2+4*s2; tp=1/l1; xc=1/(2*s2); qc=exp(-Pi/2);
RR = rich(AT,tp,NA);
print("  K Richardson 18 / 16 : ", RR[1]); print("                         ", RR[2]);
Fv=ev(F,qc); Dx=ev(D(X),qc); D2T=ev(D(D(T)),qc);
Kf=sqrt(tp*ev(D(F),qc)^2/(2*Pi*(-D2T)));
print("  K fold               = ", Kf);
print("  K fold / K Rich - 1  = ", Kf/RR[1]-1);
W2=gamma(1/4)^4/Pi^3;
print("  Dx(tau_c)/W2         = ", Dx/W2, "   (2+sqrt2)/32 = ", (2+s2)/32);
print("  diff                 = ", Dx/W2-(2+s2)/32);
Rv = xc^2*Fv/Dx^2;
print("  R(x_c) = x_c^2 F/(Dx)^2 = ", Rv, "   algdep 2: ", algdep(Rv,2), " algdep 4: ", algdep(Rv,4));
print("  K pi^{3/2}/W2        = ", Kf*Pi^(3/2)/W2);
print("  predicted |R| (2+r2) sqrt(4+r2)/8 = ", abs(Rv)*(2+s2)*sqrt(4+s2)/8);
print("################ level-12 zeta(7)");
X = 'q*et(4)^2*et(12)^2/(et(1)^2*et(3)^2);
T = X/(16*X^2+2*X+1);
PH = (E8(1)-572*E8(2)+11583*E8(3)-36608*E8(4)+46332*E8(6)-20736*E8(12))/480;
F = PH/D(T);
QT = serreverse(T+O('q^(NA+1))); AT = subst(F+O('q^(NA+1)),'q,QT);
tp=1/10; xc=1/4; qc=exp(-Pi/sqrt(3));
RR = rich(AT,tp,NA);
print("  K Richardson 18 / 16 : ", RR[1]); print("                         ", RR[2]);
Fv=ev(F,qc); Dx=ev(D(X),qc); D2T=ev(D(D(T)),qc);
Kf=sqrt(tp*ev(D(F),qc)^2/(2*Pi*(-D2T)));
print("  K fold               = ", Kf);
print("  K fold / K Rich - 1  = ", Kf/RR[1]-1);
W2=gamma(1/3)^6/Pi^4;
print("  Dx(tau_c)/W2         = ", Dx/W2, "   3^{3/2}/2^{17/3} = ", 3^(3/2)/2^(17/3));
print("  diff                 = ", Dx/W2-3^(3/2)/2^(17/3));
Rv = xc^3*Fv/Dx^3;
print("  R(x_c) = x_c^3 F/(Dx)^3 = ", Rv, "   algdep 1: ", algdep(Rv,1), " algdep 2: ", algdep(Rv,2));
print("  K pi^{3/2}/W2^2      = ", Kf*Pi^(3/2)/W2^2);
print("  predicted 324 sqrt30 R /2^{34/3} = ", 324*sqrt(30)*Rv/2^(34/3));
quit;
