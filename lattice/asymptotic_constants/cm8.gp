default(parisize,"12G");
default(realprecision,300);
M = 120;
et(k)=prod(m=1,M\k+1,1-'q^(k*m)+O('q^(M+2)));
E4(k)=1+240*sum(m=1,M\k+1,sigma(m,3)*'q^(k*m))+O('q^(M+2));
h = et(1)^3*et(4)*et(6)^2/(et(2)^2*et(3)*et(12)^3)/'q;
X = h/((h+3)*(h+4));
E = (-9*E4(3)+16*E4(4))/7;
U = 7*subst(E,'q,serreverse(X+O('q^(M+1))))/(143*'q^3+189*'q^2+21*'q+7);
NR=4200;
c=vector(NR+1); for(nn=0,60,c[nn+1]=polcoef(U,nn));
print("c_0..c_10 from q-series = ", vector(11,i,c[i]));
PV=[t^5, -66*t^5+305*t^4-570*t^3+550*t^2-269*t+53, 1691*t^5-15755*t^4+58690*t^3-109690*t^2+103501*t-39449, -2*(10138*t^5-143895*t^4+811390*t^3-2278860*t^2+3194133*t-1793904), 98601*t^5-1951090*t^4+15151580*t^3-58091120*t^2+110326362*t-83128088, 40226*t^5+59995*t^4-8141710*t^3+66849470*t^2-211362875*t+240466709, -3*(365207*t^5-9646165*t^4+101670510*t^3-535626050*t^2+1412477927*t-1493095605), -12*(2*t-11)*(84601*t^4-1861222*t^3+15473374*t^2-57603183*t+80995994)];
Pj(j,n)=if(j<=7, subst(PV[j+1],t,n), -subst(PV[15-j],t,11-n));
print("recurrence check n=14..40 (all zero): ", vector(27,i,my(nn=13+i);sum(j=0,14,Pj(j,nn)*c[nn-j+1]))==vector(27,i,0));
for(nn=61,NR, my(s=sum(j=1,14,Pj(j,nn)*c[nn-j+1])); c[nn+1]=-s/nn^5);
print("c_",NR," integral: ", denominator(c[NR+1])==1, "  log10|c_N| = ", log(abs(c[NR+1]*1.))/log(10));
xp=7-4*sqrt(3);
MPTS=20;H=150;
ns=vector(MPTS,j,NR-H*(j-1));
kn=vector(MPTS,r,abs(c[ns[r]+1])*xp^ns[r]*ns[r]^(3/2));
s1=matsolve(matrix(MPTS,MPTS,r,s,1/ns[r]^(s-1)),kn~);
s2v=matsolve(matrix(MPTS-2,MPTS-2,r,s,1/ns[r]^(s-1)),vector(MPTS-2,r,kn[r])~);
Kcf = 9*(3*(45+26*sqrt(3))/2^17)^(2/3)*sqrt((7+4*sqrt(3))/(24*sqrt(3)))*(gamma(1/3)^6/Pi^4)^2/sqrt(Pi);
print("K Richardson 20 = ", s1[1]);
print("K Richardson 18 = ", s2v[1]);
print("K closed form   = ", Kcf);
print("closed/Rich - 1 = ", Kcf/s1[1]-1);
print("sign of c_n at n=4200,4199,4198: ", vector(3,j,sign(c[NR+2-j])));
quit;
