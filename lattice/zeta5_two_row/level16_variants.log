=== level-16 zeta(5) source on several host coordinates, M=140 ===

#### plain Gamma_0(16) Hauptmodul  x
  t = 24*q^6 + 14*q^5 + 8*q^4 + 4*q^3 + 2*q^2 + q
  A_0..A_6 = [1, -56, 568, -3552, 20336, -121856, 731648]
  # A_n not in Z: 0 (lcm 1)   # d_n^5 B_n not in Z: 0
  B_n/A_n at n=139 = -1.
  lindep([B/A, zeta(5), 1]) = [477208545367, 2299838920164, -1485420346715]~   => B/A ~ -2299838920164/477208545367 * zeta(5) + 1485420346715/477208545367
  log|A_n|/n = 1.
  v_p(A_n):
    p=2: 7 13 13 13 14 13
    p=3: 0 0 0 2 0 1
    p=5: 0 0 0 0 0 0
  SLOPE v_p(B_n/A_n - B_{n-1}/A_{n-1}):
    p=2: -2 8 34 58 78 122
    p=3: -8 -7 -15 -16 -21 -21
    p=5: -5 -10 -10 -10 -10 -15

