default(realprecision, 40);
LOG = "/home/ubuntu/code/math-modular-sources/lattice/multislope/row1_logfit.log";
W(s) = write(LOG, s);
SS = [1000, 3000, 10000, 30000, 100000, 300000];
RB = [0.7698534365374514247298816510276297700352, 0.8107115004854399753836370014033351203190, 0.8470572686934506515490243913729223607873, 0.8745018269052969432154083889396811725500, 0.8998245470222124263206266061307544316688, 0.9195373642668855223962123451983770728238];
RC = [0.3969763186129434700753442820240377649041, 0.4333813170458786956123023805610583517554, 0.4663029836932860215474602088739684319503, 0.4914741697447251302075160641593208988267, 0.5149237785424100598830330437191379118486, 0.5333206581090981315436494434341763326950];
RD = [0.1306985485035681449499154084626904594924, 0.1460104164470200959610151662689373139528, 0.1599958948745176446742435444179799169548, 0.1707681655640067409031090624798528275718, 0.1808599795163905456792758276269812077434, 0.1888126211500983352070840555588681693945];
RE = [0.03346685911892465605120183468830064968802, 0.03804364151763596473702164136014334574254, 0.04225529998008939941030265949298574294961, 0.04551705335954912381964912393992084781567, 0.04858527528818303733858725346124333482114, 0.05101092495860525552991729062807065101457];
RF = [0.007362086433504895138450496065628765321962, 0.008489632074327234077339536014350328527318, 0.009533606900578379195332105479759539168840, 0.01034570672368437066079937750344820048032, 0.01111213558549926265982758713513111804630, 0.01171961458700285550708802714100605621597];
AL = [RB,RC,RD,RE,RF]; CN = ["B","C","D","E","F"];
{ W(""); W("=== Row 1: multi-term extrapolation in powers of 1/log n (data n <= 3*10^5) ===");
  for(s=1,5, my(rv = AL[s], str = Str("  ", CN[s], ":"), idx, mt, sol);
    for(J=1,4,
      idx = vector(J+1, i, 6-J+i-1);
      mt = matrix(J+1, J+1, a, b, 1.0/log(SS[idx[a]]*1.0)^(b-1));
      sol = matsolve(mt, vector(J+1, a, rv[idx[a]])~);
      str = Str(str, "  [", J+1, "-term] ", sol[1]));
    W(str));
  W("  (spread across fit orders = honest error bar)"); }
quit;
