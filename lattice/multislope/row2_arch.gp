default(parisizemax, 6000000000);
LOG = "/home/ubuntu/code/math-modular-sources/lattice/multislope/row2_arch.log";
W(s) = write(LOG, s);
th='th;
P0 =  th^4;
P1 = -2^4*(1072*th^4 - 17824*th^3 - 10888*th^2 - 1976*th - 145);
P2 = -2^17*(51088*th^4 + 116368*th^3 - 45264*th^2 - 14228*th - 1397);
P3 =  2^28*13*(73104*th^4 + 1536*th^3 - 488*th^2 + 384*th + 97);
P4 = -2^44*13^2*(2*th+1)^4;
PL = [P0,P1,P2,P3,P4];
Qp = vector(5, i, subst(PL[i], th, 'n-(i-1)));
NB = if(type(NBIG)=="t_INT", NBIG, 5000);
QC = vector(5, i, Vecrev(Qp[i]));
ev(i,n) = { my(v=QC[i+1], s=0, t=1); for(j=1,#v, s+=v[j]*t; t*=n); s };
run(seed) = {
  my(cur = vector(NB+1), sm);
  cur[seed+1] = (seed!)^4;
  for(n = seed+1, NB,
    sm = 0;
    if(n>=1, if(cur[n]   != 0, sm += ev(1,n)*cur[n]));
    if(n>=2, if(cur[n-1] != 0, sm += ev(2,n)*(n-1)^4*cur[n-1]));
    if(n>=3, if(cur[n-2] != 0, sm += ev(3,n)*((n-1)*(n-2))^4*cur[n-2]));
    if(n>=4, if(cur[n-3] != 0, sm += ev(4,n)*((n-1)*(n-2)*(n-3))^4*cur[n-3]));
    cur[n+1] = -sm);
  cur};
W(Str("=== AESZ207 archimedean, N = ", NB, " ==="));
gettime();
WA = run(0);
W(Str("A built in ", gettime(), " ms; decimal size of scaled A_N = ", #Str(abs(WA[NB+1]))));
W(Str("check A_1..A_3 = ", vector(3,i,WA[i+1]/(i!)^4)));
default(realprecision, 1400);
CN = ["B","C","D"]; RES = vector(3);
for(s=1,3, my(wx = run(s), r1, r2, r3); r1 = wx[NB+1]/WA[NB+1]; r2 = wx[NB-99]/WA[NB-99]; r3 = wx[NB-199]/WA[NB-199]; RES[s] = r1*1.0; W(Str("  ", CN[s], "  r_N = ", r1*1.0)); W(Str("      |r_N - r_{N-100}|     = ", abs(r1-r2)*1.0)); W(Str("      |r_{N-100}-r_{N-200}| = ", abs(r2-r3)*1.0)); wx = 0);
default(realprecision, 1100);
vv = vector(4); vv[1] = 1.0; for(s=1,3, vv[s+1] = RES[s]*1.0);
W("");
W("--- lindep over Q at 1100 digits ---");
W(Str("  lindep([1,xiB,xiC,xiD])  = ", lindep(vv)));
W(Str("  lindep([1,xiB,xiC])      = ", lindep([vv[1],vv[2],vv[3]])));
W(Str("  lindep([1,xiB,xiD])      = ", lindep([vv[1],vv[2],vv[4]])));
W(Str("  lindep([1,xiC,xiD])      = ", lindep([vv[1],vv[3],vv[4]])));
W(Str("  lindep([xiB,xiC,xiD])    = ", lindep([vv[2],vv[3],vv[4]])));
W(Str("  lindep([1,xiB])          = ", lindep([vv[1],vv[2]])));
W(Str("  lindep([xiB,xiC])        = ", lindep([vv[2],vv[3]])));
W(Str("  lindep([xiB,xiD])        = ", lindep([vv[2],vv[4]])));
W(Str("  xiC/xiB = ", RES[2]/RES[1]));
W(Str("  xiD/xiB = ", RES[3]/RES[1]));
W(Str("  algdep(xiC/xiB, 2) = ", algdep(RES[2]/RES[1], 2)));
W(Str("  algdep(xiD/xiB, 2) = ", algdep(RES[3]/RES[1], 2)));
write("/home/ubuntu/code/math-modular-sources/lattice/multislope/row2_arch.txt", Str("XIARCH = ", RES));
W("DONE");
quit;
