default(realprecision, 300);
G = Catalan; z2 = zeta(2);
L3 = lfun(lfuncreate(-3), 2);
CANDS = [["G/4", G/4], ["G/2 - 3 zeta(2)/16", G/2-3*z2/16], ["3 zeta(2)/8 - G/2", 3*z2/8-G/2], ["(2 zeta(2) + 15 L(2,chi_m3))/32", (2*z2+15*L3)/32], ["(15 L(2,chi_m3) - 6 zeta(2))/16", (15*L3-6*z2)/16], ["(2 zeta(2) - 3 L(2,chi_m3))/8", (2*z2-3*L3)/8]];
docheck(lab, xi) = my(hit=0); print("== ", lab); for(k=1,#CANDS, my(dd=abs(xi-CANDS[k][2])); if(dd < 10.0^(-100), hit=1; print("   MATCH  xi = ", CANDS[k][1]); print("      |xi-target| = ", dd); print("      agreeing digits = ", floor(-log(dd/abs(xi))/log(10))))); if(!hit, print("   NO MATCH")); 0;
