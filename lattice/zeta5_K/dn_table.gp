default(parisize,"4G");
default(realprecision,540);
M=60;
et(k)=prod(n=1,M+1,1-q^(k*n)+O(q^(M+2)));
h=et(1)^3*et(4)*et(6)^2/(et(2)^2*et(3)*et(12)^3)/q;
X=h/((h+3)*(h+4));
E4(k)=1+240*sum(n=1,M+1,sigma(n,3)*q^(k*n))+O(q^(M+2));
E6(k)=1-504*sum(n=1,M+1,sigma(n,5)*q^(k*n))+O(q^(M+2));
E=(-9*E4(3)+16*E4(4))/7;
Fm=E6(1)-176*E6(2)+2079*E6(3)-4928*E6(4)+4752*E6(6)-1728*E6(12);
Ft=-Fm/504;
print("Ftilde = ",Ft+O(q^6));
A=vector(M+1,n,polcoeff(Ft,n));
f=sum(n=1,M+1,A[n]/n^5*q^n)+O(q^(M+2));
qx=serreverse(X);
Ux=7*subst(E,q,qx)/(143*q^3+189*q^2+21*q+7);
Vx=Ux*subst(f,q,qx);
N=420;
c=vector(N+1); d=vector(N+1);
for(n=0,20, c[n+1]=polcoeff(Ux,n); d[n+1]=polcoeff(Vx,n));
print("d_0..d_6 = ",vector(7,i,d[i]));
Dn(n)=lcm(vector(n,i,i));
print("D_n^5 d_n integral for n<=20: ",vector(20,n,denominator(d[n+1]*Dn(n)^5)));
C5=11/144*zeta(5);
PV=[t^5, -66*t^5+305*t^4-570*t^3+550*t^2-269*t+53, 1691*t^5-15755*t^4+58690*t^3-109690*t^2+103501*t-39449, -2*(10138*t^5-143895*t^4+811390*t^3-2278860*t^2+3194133*t-1793904), 98601*t^5-1951090*t^4+15151580*t^3-58091120*t^2+110326362*t-83128088, 40226*t^5+59995*t^4-8141710*t^3+66849470*t^2-211362875*t+240466709, -3*(365207*t^5-9646165*t^4+101670510*t^3-535626050*t^2+1412477927*t-1493095605), -12*(2*t-11)*(84601*t^4-1861222*t^3+15473374*t^2-57603183*t+80995994)];
Pj(j,n)=if(j<=7, subst(PV[j+1],t,n), -subst(PV[15-j],t,11-n));
print("recurrence check for d, n=14..20 (should be 13*2^18*(-1)^(n+1)): ",vector(7,i,my(nn=13+i);sum(j=0,14,Pj(j,nn)*d[nn-j+1])/(13*2^18)));
for(nn=21,N, my(s=sum(j=1,14,Pj(j,nn)*c[nn-j+1])); c[nn+1]=-s/nn^5; my(sd=sum(j=1,14,Pj(j,nn)*d[nn-j+1])); d[nn+1]=(13*2^18*(-1)^(nn+1)-sd)/nn^5);
print("c_400 integral: ",denominator(c[401])==1, "   D_400^5 d_400 integral: ",denominator(d[401]*Dn(400)^5)==1);
K=0.68537184849053440595143004488054241747925748918627;
xp=7-4*sqrt(3);
asym(n)=13/(96*K)*(-1)^n*xp^n*sqrt(n)*log(n)^4;
print("n | log10|d_n/c_n - C5| | log10|asym| | ratio err/asym | (err)^(1/n) | digits of zeta(5) from 144 d_n/(11 c_n)");
foreach([5,10,20,50,100,200,400],n, my(e=d[n+1]/c[n+1]-C5); print(n," | ",precision(log(abs(e))/log(10),8)," | ",precision(log(abs(asym(n)))/log(10),8)," | ",precision(e/asym(n),8)," | ",precision(abs(e)^(1/n),8)," | ",precision(-log(abs(144*d[n+1]/(11*c[n+1])/zeta(5)-1))/log(10),8)));
print("c_n for n=0..8: ",vector(9,i,c[i]));
print("144 d_1/(11 c_1), etc: ",vector(6,i,144*d[i+1]/(11*c[i+1])));
quit;
